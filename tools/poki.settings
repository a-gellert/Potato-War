; Overrides for the Poki web build: sh tools/build.sh poki
; (bob --settings tools/poki.settings). game.project stays the Playgama/Android configuration.
;
; The Poki SDK extension merges its own HTML into the page (it loads poki-sdk.js from Poki's CDN
; and starts the engine after PokiSDK.init), so it must only be part of the Poki build: in the
; Playgama build it pulled Poki's SDK onto every Playgama portal and reported errors to Poki.
; The Poki page also must not load the Playgama bridge, hence the stock Defold HTML template.

[project]
dependencies#6 = https://github.com/defold/extension-poki-sdk/archive/refs/tags/4.1.0.zip

[html5]
htmlfile = /builtins/manifests/web/engine_template.html

[sdk]
target = poki
