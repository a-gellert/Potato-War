[bootstrap]
main_collection = /main/main.collectionc
render = /main/game.renderc

[script]
shared_state = 1

[display]
width = 960
height = 540
high_dpi = 1

[android]
input_method = HiddenInputField
minimum_sdk_version = 24
app_icon_192x192 = /main/assets/logo2 (1).png
app_icon_144x144 = /main/assets/logo2 (1).png
app_icon_96x96 = /main/assets/logo2 (1).png
app_icon_72x72 = /main/assets/logo2 (1).png
app_icon_48x48 = /main/assets/logo2 (1).png
app_icon_36x36 = /main/assets/logo2 (1).png
package = com.turnbased.artillery.potato.war

[html5]
scale_mode = stretch
wasm_streaming = 1
show_fullscreen_button = 0
show_made_with_defold = 0
htmlfile = /bridge/engine_template.html

[project]
title = Great Potato War
bundle_resources = /res
dependencies#0 = https://github.com/Playgama/bridge-defold/archive/refs/tags/v2.3.0.zip
dependencies#1 = https://github.com/Insality/druid/archive/master.zip
dependencies#2 = https://github.com/britzl/defold-orthographic/archive/master.zip
dependencies#3 = https://github.com/defold/extension-poki-sdk/archive/refs/tags/4.1.0.zip
dependencies#4 = https://github.com/defold/extension-applovin/archive/refs/tags/2.0.0.zip

[graphics]
opengl_version_hint = 42

[sprite]
max_count = 2048

[collection]
max_instances = 2048

[sound]
max_sound_data = 128
max_sound_instances = 128
max_sound_sources = 64
max_component_count = 64

[sdk]
target = playgama

[applovin]
bigo_android = 1
mintegral_android = 1
yandex_android = 1
bidmachine_android = 1
google_android = 0
google_android_app_id = 
bigo_ios = 1
mintegral_ios = 1
yandex_ios = 1
bidmachine_ios = 1
google_ios = 0
google_ios_app_id = 
ios_user_tracking_usage_description = This identifier will be used to deliver personalized ads to you.

[max]
sdk_key = 
android_rewarded_ad_unit_id = 
android_interstitial_ad_unit_id = 
android_banner_ad_unit_id = 
ios_rewarded_ad_unit_id = 
ios_interstitial_ad_unit_id = 
ios_banner_ad_unit_id = 
privacy_policy_url = 
terms_of_service_url = 
debug_mode = 0

