-- main/entities/aim_guide/aim_guide.script
-- Angry Birds style slingshot drag-and-release aiming and trajectory visualization

local constants = require("lua_modules.constants")
local weapons = require("lua_modules.weapons")
local physics_sim = require("lua_modules.physics_sim")
local terrain_grid = require("lua_modules.terrain_grid")
local game_state = require("lua_modules.game_state")
local camera_controller = require("lua_modules.camera_controller")
local match_spawner = require("lua_modules.match_spawner")

local MAX_DOTS = 14

local function hide_guide(self)
	if self.crosshair then
		msg.post(self.crosshair, "disable")
	end
	if self.dots then
		for i = 1, MAX_DOTS do
			if self.dots[i] then
				msg.post(self.dots[i], "disable")
			end
		end
	end
	self.crosshair_tint = nil
	game_state.aim_target_x = nil
	game_state.aim_target_y = nil
end

-- Airstrike targeting: only the crosshair, standing on the ground below the marked x
local function show_target(self, wx, wy)
	for i = 1, MAX_DOTS do
		if self.dots[i] then
			msg.post(self.dots[i], "disable")
		end
	end
	wx = math.max(20, math.min(constants.WORLD_WIDTH - 20, wx))
	local gy = terrain_grid.get_smooth_ground_y(wx, 4.0, wy)
	local y = math.max(constants.WATER_LEVEL + 6, math.min(wy, gy + 10))
	msg.post(self.crosshair, "enable")
	go.set_position(vmath.vector3(wx, y, 0.35), self.crosshair)
	go.set(msg.url(nil, self.crosshair, "sprite"), "tint", vmath.vector4(1, 1, 1, 1))
	self.crosshair_tint = nil
	game_state.aim_target_x = wx
	game_state.aim_target_y = y
	return wx
end

local TINT_NORMAL = vmath.vector4(1, 1, 1, 1)
local TINT_DANGER = vmath.vector4(1.0, 0.25, 0.2, 1)   -- the blast would catch the shooter
local TINT_ON_TARGET = vmath.vector4(0.45, 1.0, 0.4, 1) -- an enemy stands inside the blast

-- How the shot's end point relates to the shooter and the enemies
local function impact_tint(shooter, weapon, x, y, ended_on_ground)
	local reach = (weapon.blast_radius or 20) + constants.POTATO_RADIUS
	if shooter and ended_on_ground and (weapon.blast_radius or 0) >= 20 then
		local dx, dy = shooter.pos.x - x, shooter.pos.y - y
		if dx * dx + dy * dy < reach * reach then
			return TINT_DANGER
		end
	end
	for _, p in ipairs(game_state.potatoes) do
		if p.is_alive and shooter and p.team ~= shooter.team then
			local dx, dy = p.pos.x - x, p.pos.y - y
			if dx * dx + dy * dy < reach * reach then
				return TINT_ON_TARGET
			end
		end
	end
	return TINT_NORMAL
end

local function show_trajectory(self, origin_x, origin_y, vx, vy, weapon)
	local points = physics_sim.calculate_trajectory(origin_x, origin_y, vx, vy, weapon, terrain_grid, MAX_DOTS, game_state.wind_vector)
	local last_pt = points[#points]
	-- The preview stops early on long arcs: only a stop short of MAX_DOTS is a real impact
	local tint = last_pt and impact_tint(game_state.active_potato, weapon, last_pt.x, last_pt.y, #points < MAX_DOTS) or TINT_NORMAL

	for i = 1, MAX_DOTS do
		local dot_url = self.dots[i]
		if dot_url then
			if i <= #points then
				msg.post(dot_url, "enable")
				go.set_position(vmath.vector3(points[i].x, points[i].y, 0.3), dot_url)
				local s = 0.28 * (1.0 - (i / (MAX_DOTS + 4)))
				go.set_scale(vmath.vector3(s, s, 1.0), dot_url)
				-- Dots fade out towards the end of the preview
				local c = vmath.vector4(tint)
				c.w = 1.0 - 0.55 * (i - 1) / MAX_DOTS
				go.set(msg.url(nil, dot_url, "sprite"), "tint", c)
			else
				msg.post(dot_url, "disable")
			end
		end
	end

	if #points > 0 and self.crosshair then
		msg.post(self.crosshair, "enable")
		go.set_position(vmath.vector3(last_pt.x, last_pt.y, 0.35), self.crosshair)
		go.set(msg.url(nil, self.crosshair, "sprite"), "tint", tint)
		if tint ~= self.crosshair_tint then
			-- Pop the crosshair when its meaning changes
			self.crosshair_tint = tint
			go.cancel_animations(self.crosshair, "scale")
			go.set_scale(vmath.vector3(1.35, 1.35, 1), self.crosshair)
			go.animate(self.crosshair, "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(1, 1, 1), go.EASING_OUTBACK, 0.22)
		end

		-- Update aim target coordinates for dynamic camera zoom & framing
		game_state.aim_target_x = last_pt.x
		game_state.aim_target_y = last_pt.y

		-- Alert enemy potatoes if directly targeted during player turn
		if not game_state.is_bot_turn() then
			for _, p in ipairs(game_state.potatoes) do
				if p.is_alive and p.team ~= game_state.active_team and p.url then
					local pdx = p.pos.x - last_pt.x
					local pdy = (p.pos.y + 4) - last_pt.y
					if pdx * pdx + pdy * pdy < 36 * 36 then
						msg.post(p.url, "alert_aimed")
					end
				end
			end
		end
	elseif self.crosshair then
		msg.post(self.crosshair, "disable")
		game_state.aim_target_x = nil
		game_state.aim_target_y = nil
	end
end

function init(self)
	msg.post(".", "acquire_input_focus")
	self.dragging = false
	self.drag_start = vmath.vector3(0, 0, 0)
	self.last_vx = 0
	self.last_vy = 0

	-- Spawn trajectory dot game objects
	self.dots = {}
	for i = 1, MAX_DOTS do
		local d = factory.create("#dot_factory", vmath.vector3(-100, -100, 0.3))
		msg.post(d, "disable")
		self.dots[i] = d
	end

	-- Spawn crosshair game object
	self.crosshair = factory.create("#crosshair_factory", vmath.vector3(-100, -100, 0.35))
	msg.post(self.crosshair, "disable")
end

function final(self)
	if self.crosshair then
		pcall(go.delete, self.crosshair)
	end
	if self.dots then
		for _, d in ipairs(self.dots) do
			pcall(go.delete, d)
		end
	end
end

-- Airstrike: press, slide to the spot and release to call the plane
local function on_target_input(self, potato, weapon, action)
	if action.pressed then
		if action.y < 82 or (action.y > 485 and action.x > 820) then
			self.dragging = false
			return false
		end
		self.dragging = true
		game_state.poki_gameplay_start()
	end
	if not self.dragging then
		return false
	end

	local wx, wy = camera_controller.screen_to_world(action.x, action.y)
	local tx = show_target(self, wx, wy)
	game_state.is_aiming = true
	msg.post("/gui_hud#gui", "hide_tutorial")
	local facing_dir = (tx >= potato.pos.x) and 1 or -1
	if potato.facing ~= facing_dir then
		potato.facing = facing_dir
		if potato.url then
			msg.post(potato.url, "set_facing", { facing = facing_dir })
		end
	end

	if action.released then
		self.dragging = false
		game_state.is_aiming = false
		hide_guide(self)
		game_state.tutorial_first_shot_done = true
		msg.post("/gui_hud#gui", "tutorial_shot_fired")
		msg.post("/main#main", "fire_weapon", {
			origin_x = potato.pos.x,
			origin_y = potato.pos.y + 8,
			vel_x = 0,
			vel_y = 0,
			target_x = tx,
			weapon_id = weapon.id,
			owner_id = potato.id
		})
	end
	return true
end

function on_input(self, action_id, action)
	-- Only allow input when active turn and not bot
	if game_state.state ~= constants.STATE_TURN_ACTIVE then
		if self.dragging then
			self.dragging = false
			hide_guide(self)
		end
		return false
	end

	if game_state.is_bot_turn() then
		return false
	end

	local potato = game_state.active_potato
	if not potato or not potato.is_alive then
		return false
	end

	local weapon = weapons.get(game_state.selected_weapon_id)

	if action_id == hash("touch") and weapon.aim == "target" then
		return on_target_input(self, potato, weapon, action)
	end

	if action_id == hash("touch") then
		if action.pressed then
			if action.y < 82 or (action.y > 485 and action.x > 820) then
				self.dragging = false
				return false
			end
			hide_guide(self)
			self.dragging = true
			self.drag_start = vmath.vector3(action.x, action.y, 0)
			game_state.poki_gameplay_start()

		elseif self.dragging and not action.released then
			local is_slingshot = (game_state.aim_control_mode == "slingshot")
			local aim_x, aim_y

			if is_slingshot then
				local raw_dx = action.x - self.drag_start.x
				local raw_dy = action.y - self.drag_start.y
				aim_x = -raw_dx
				aim_y = -raw_dy
			else
				-- Direct mode: aim from unit's screen position towards the touch / cursor point
				local psx, psy = camera_controller.world_to_screen(potato.pos.x, potato.pos.y + 8)
				aim_x = action.x - psx
				aim_y = action.y - psy
			end

			local len = math.sqrt(aim_x * aim_x + aim_y * aim_y)

			-- Aim sensitivity from config (mouse vs touchscreen)
			local sens = match_spawner.is_mobile_platform()
				and (constants.AIM_SENSITIVITY_TOUCH or 0.5)
				or (constants.AIM_SENSITIVITY_MOUSE or 0.5)

			local min_len = is_slingshot and 12 or 16
			if len > min_len then
				game_state.is_aiming = true
				msg.post("/gui_hud#gui", "hide_tutorial")
				local dir_x = aim_x / len
				local dir_y = aim_y / len
				local effective_len = len * sens
				local power = (weapon.fixed_power and weapon.max_power or math.min(weapon.max_power, effective_len * weapon.power_scale)) * physics_sim.LAUNCH_BOOST

				local vx = dir_x * power
				local vy = dir_y * power
				self.last_vx = vx
				self.last_vy = vy

				-- Turn potato towards firing direction
				local facing_dir = (aim_x >= 0) and 1 or -1
				potato.facing = facing_dir
				if potato.url then
					msg.post(potato.url, "set_facing", { facing = facing_dir })
					msg.post(potato.url, "set_aim", { vx = vx, vy = vy })
				end

				show_trajectory(self, potato.pos.x, potato.pos.y + 8, vx, vy, weapon)
			else
				hide_guide(self)
			end

		elseif action.released and self.dragging then
			self.dragging = false
			game_state.is_aiming = false
			local is_slingshot = (game_state.aim_control_mode == "slingshot")
			local aim_x, aim_y

			if is_slingshot then
				local raw_dx = action.x - self.drag_start.x
				local raw_dy = action.y - self.drag_start.y
				aim_x = -raw_dx
				aim_y = -raw_dy
			else
				local psx, psy = camera_controller.world_to_screen(potato.pos.x, potato.pos.y + 8)
				aim_x = action.x - psx
				aim_y = action.y - psy
			end

			local len = math.sqrt(aim_x * aim_x + aim_y * aim_y)
			hide_guide(self)

			local min_fire_len = is_slingshot and 16 or 20
			if len > min_fire_len and (self.last_vx ~= 0 or self.last_vy ~= 0) then
				-- Fire weapon!
				game_state.tutorial_first_shot_done = true
				msg.post("/gui_hud#gui", "tutorial_shot_fired")
				msg.post("/main#main", "fire_weapon", {
					origin_x = potato.pos.x,
					origin_y = potato.pos.y + 8,
					vel_x = self.last_vx,
					vel_y = self.last_vy,
					weapon_id = weapon.id,
					owner_id = potato.id
				})
			else
				-- Short tap without drag: trigger helpful reminder
				msg.post("/gui_hud#gui", "tutorial_tap_hint")
				if potato.url then
					msg.post(potato.url, "on_jump")
				end
			end
		end
		return true
	end

	return false
end

function on_message(self, message_id, message, sender)
	if message_id == hash("bot_aim_preview") then
		local potato = game_state.active_potato
		if potato and potato.is_alive then
			local weapon = weapons.get(message.weapon_id)
			if weapon.aim == "target" and message.target_x then
				show_target(self, message.target_x, constants.WORLD_HEIGHT)
				return
			end
			show_trajectory(self, potato.pos.x, potato.pos.y + 8, message.vx, message.vy, weapon)
			local facing_dir = (message.vx >= 0) and 1 or -1
			potato.facing = facing_dir
			if potato.url then
				msg.post(potato.url, "set_facing", { facing = facing_dir })
				msg.post(potato.url, "set_aim", { vx = message.vx, vy = message.vy })
			end
		end

	elseif message_id == hash("tutorial_aim_preview") then
		if not self.dragging and not game_state.is_aiming then
			local potato = game_state.active_potato
			if potato and potato.is_alive then
				local weapon = weapons.get(message.weapon_id or game_state.selected_weapon_id or "bazooka")
				show_trajectory(self, potato.pos.x, potato.pos.y + 8, message.vx, message.vy, weapon)
				local facing_dir = (message.vx >= 0) and 1 or -1
				potato.facing = facing_dir
				if potato.url then
					msg.post(potato.url, "set_facing", { facing = facing_dir })
					msg.post(potato.url, "set_aim", { vx = message.vx, vy = message.vy })
				end
			end
		end

	elseif message_id == hash("hide_tutorial_aim") then
		if not self.dragging and not game_state.is_aiming then
			hide_guide(self)
		end

	elseif message_id == hash("hide_aim") then
		self.dragging = false
		game_state.is_aiming = false
		hide_guide(self)
	end
end
