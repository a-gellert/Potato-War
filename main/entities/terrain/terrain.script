-- main/entities/terrain/terrain.script
-- Manages destructible terrain texture updates, dynamic biomes, and environment themes for Potato War

local constants = require("lua_modules.constants")
local terrain_grid = require("lua_modules.terrain_grid")

local TEXTURE_PATH = "/dynamic_terrain.texturec"
local ATLAS_PATH = "/dynamic_terrain.texturesetc"

local BIOME_THEMES = {
	grass = {
		sky = vmath.vector4(0.35, 0.75, 0.98, 1.0),
		water = vmath.vector4(0.10, 0.65, 0.96, 0.95),
	},
	desert = {
		sky = vmath.vector4(0.98, 0.68, 0.36, 1.0),
		water = vmath.vector4(0.08, 0.82, 0.78, 0.95),
	},
	arctic = {
		sky = vmath.vector4(0.52, 0.80, 0.98, 1.0),
		water = vmath.vector4(0.14, 0.48, 0.88, 0.95),
	},
	volcano = {
		sky = vmath.vector4(0.52, 0.16, 0.22, 1.0),
		water = vmath.vector4(1.00, 0.42, 0.06, 0.96),
	},
	alien = {
		sky = vmath.vector4(0.28, 0.10, 0.48, 1.0),
		water = vmath.vector4(0.12, 0.95, 0.58, 0.95),
	},
}

local function write_terrain_pixel(stream, idx, gx, gy, w, h, grid, biome)
	local row = gy * w
	local solid = (grid[row + gx + 1] == 1)
	if not solid then
		stream[idx] = 0
		stream[idx + 1] = 0
		stream[idx + 2] = 0
		stream[idx + 3] = 0
		return
	end

	-- Depth from surface (check up to 6 cells above for a lush, thick top crust!)
	local depth = 6
	for d = 1, 6 do
		local above_y = gy + d
		if above_y >= h or grid[above_y * w + gx + 1] == 0 then
			depth = d - 1
			break
		end
	end

	local r, g, b = 100, 100, 100

	if biome == "desert" then
		-- VIBRANT GOLDEN DESERT & CORAL CANYON BIOME
		if depth == 0 then
			local fl = (gx * 37 + gy * 13) % 23
			if fl == 0 then
				r = 65; g = 240; b = 215 -- Oasis turquoise gem
			elseif fl == 1 then
				r = 255; g = 105; b = 135 -- Desert cactus blossom pink
			else
				local v = ((gx * 37) % 7) * 4 - 10
				r = math.max(220, math.min(255, 252 + v))
				g = math.max(190, math.min(245, 222 + v))
				b = math.max(95, math.min(165, 118 + v))
			end
		elseif depth <= 2 then
			r = 246; g = 192; b = 96
		elseif depth <= 4 then
			r = 232; g = 148; b = 78
		elseif depth == 5 then
			r = 212; g = 115; b = 68
		else
			local strata = math.sin((gy + math.sin(gx * 0.06) * 5) * 0.22) * 26
			local grain = ((gx * 17 + gy * 31) % 11) * 2 - 10
			r = math.max(110, math.min(248, 198 + strata + grain))
			g = math.max(60, math.min(185, 108 + strata * 0.6 + grain * 0.5))
			b = math.max(40, math.min(135, 68 + strata * 0.3 + grain * 0.3))

			-- Gold & turquoise mineral specks
			local speck = (gx * 47 + gy * 83) % 89
			if speck == 0 then
				r = 255; g = 215; b = 55
			elseif speck == 1 then
				r = 65; g = 225; b = 210
			end
		end

	elseif biome == "arctic" then
		-- SPARKLING AURORA ICE & CRYSTAL SNOW BIOME
		if depth == 0 then
			local sp = (gx * 29 + gy * 17) % 19
			if sp == 0 then
				r = 115; g = 245; b = 255 -- Sparkling cyan ice crystal
			elseif sp == 1 then
				r = 235; g = 145; b = 255 -- Aurora pink-violet glint
			else
				r = 250; g = 254; b = 255
			end
		elseif depth <= 2 then
			r = 222; g = 244; b = 255
		elseif depth <= 4 then
			r = 155; g = 215; b = 250
		elseif depth == 5 then
			r = 112; g = 182; b = 238
		else
			local strata = math.sin((gy + math.cos(gx * 0.05) * 8) * 0.18) * 24
			local grain = ((gx * 19 + gy * 29) % 11) * 2 - 10
			r = math.max(45, math.min(185, 82 + strata * 0.5 + grain))
			g = math.max(95, math.min(225, 148 + strata * 0.8 + grain))
			b = math.max(145, math.min(255, 212 + strata + grain))

			-- Glistening ice & aurora crystal specks
			local speck = (gx * 43 + gy * 79) % 83
			if speck == 0 then
				r = 240; g = 252; b = 255
			elseif speck == 1 then
				r = 195; g = 135; b = 255
			end
		end

	elseif biome == "volcano" then
		-- JUICY MAGMA GOLD & VIOLET OBSIDIAN BIOME
		if depth == 0 then
			local ember = ((gx * 41) % 9) <= 2
			if ember then
				r = 255; g = 195; b = 35 -- Bright golden-orange flame crest
			else
				r = 248; g = 88; b = 28 -- Glowing lava crust
			end
		elseif depth <= 2 then
			r = 215; g = 62; b = 32
		elseif depth <= 4 then
			r = 115; g = 45; b = 68
		elseif depth == 5 then
			r = 85; g = 38; b = 62
		else
			local magma = math.sin((gy * 0.15 + math.sin(gx * 0.08) * 3))
			local grain = ((gx * 17 + gy * 31) % 11) * 2 - 10
			if magma > 0.72 then
				-- Bright molten magma river glowing inside rock
				r = 255; g = 120; b = 22
			else
				local base = 58 + grain
				r = math.max(40, math.min(130, base + 18))
				g = math.max(28, math.min(95, base - 4))
				b = math.max(45, math.min(135, base + 22))
			end

			-- Bright gold/orange fire rubies
			if ((gx * 53 + gy * 71) % 79) <= 1 then
				r = 255; g = 185; b = 30
			end
		end

	elseif biome == "alien" then
		-- ELECTRIC NEON CYBER-SPORE & CRYSTAL BIOME
		if depth == 0 then
			local neon = (gx * 31) % 14
			if neon <= 1 then
				r = 55; g = 255; b = 195 -- Neon cyber-mint flower
			elseif neon == 2 then
				r = 255; g = 235; b = 55 -- Electric yellow spore
			else
				r = 248; g = 78; b = 255 -- Hot neon magenta grass
			end
		elseif depth <= 2 then
			r = 212; g = 58; b = 235
		elseif depth <= 4 then
			r = 148; g = 44; b = 192
		elseif depth == 5 then
			r = 104; g = 38; b = 158
		else
			local strata = math.sin((gy + math.sin(gx * 0.05) * 6) * 0.18) * 22
			local grain = ((gx * 19 + gy * 37) % 11) * 2 - 10
			r = math.max(45, math.min(175, 78 + strata * 0.6 + grain))
			g = math.max(25, math.min(135, 38 + strata * 0.4 + grain))
			b = math.max(75, math.min(225, 132 + strata * 0.9 + grain))

			-- Glowing neon cyan & gold crystal specks
			local speck = (gx * 47 + gy * 83) % 73
			if speck == 0 then
				r = 45; g = 255; b = 225
			elseif speck == 1 then
				r = 255; g = 215; b = 55
			end
		end

	else
		-- DEFAULT: LUSH SUNNY MEADOW & WILDFLOWER BIOME
		if depth == 0 then
			local flower = (gx * 43 + gy * 11) % 17
			if flower == 0 then
				r = 255; g = 230; b = 45 -- Sunny dandelion yellow flower
			elseif flower == 1 then
				r = 255; g = 95; b = 125 -- Coral pink blossom
			elseif flower == 2 then
				r = 95; g = 205; b = 255 -- Sky-blue forget-me-not
			else
				local v = ((gx * 37) % 7) * 4 - 10
				r = math.max(55, math.min(125, 82 + v))
				g = math.max(195, math.min(255, 228 + v * 2))
				b = math.max(35, math.min(85, 52 + v))
			end
		elseif depth <= 2 then
			r = 62; g = 204; b = 44
		elseif depth <= 4 then
			r = 102; g = 165; b = 42
		elseif depth == 5 then
			r = 148; g = 112; b = 56
		else
			local strata = math.sin((gy + math.sin(gx * 0.05) * 6) * 0.18) * 20
			local grain = ((gx * 17 + gy * 31) % 11) * 2 - 10
			r = math.max(85, math.min(235, 162 + strata + grain))
			g = math.max(55, math.min(190, 106 + strata * 0.75 + grain))
			b = math.max(35, math.min(145, 62 + strata * 0.45 + grain * 0.5))

			-- Colorful buried gems & warm stones
			local speck = (gx * 47 + gy * 83) % 89
			if speck == 0 then
				r = 255; g = 205; b = 65 -- Gold nugget
			elseif speck == 1 then
				r = 85; g = 225; b = 155 -- Emerald pebble
			end
		end
	end

	-- Warm sunlit/scorched rim around exposed side/bottom crater cuts
	local is_exposed = (gx > 0 and grid[row + gx] == 0)
		or (gx < w - 1 and grid[row + gx + 2] == 0)
		or (gy > 0 and grid[(gy - 1) * w + gx + 1] == 0)
	if is_exposed and depth > 1 then
		r = math.min(255, r * 0.88 + 28)
		g = math.min(255, g * 0.84 + 14)
		b = b * 0.80
	end

	stream[idx] = math.floor(r)
	stream[idx + 1] = math.floor(g)
	stream[idx + 2] = math.floor(b)
	stream[idx + 3] = 255
end

local function fill_full_stream(self)
	local w = self.w
	local h = self.h
	local stream = self.stream
	local grid = terrain_grid.grid
	local biome = self.current_biome or "grass"

	local idx = 1
	for gy = 0, h - 1 do
		for gx = 0, w - 1 do
			write_terrain_pixel(stream, idx, gx, gy, w, h, grid, biome)
			idx = idx + 4
		end
	end
end

local function apply_biome_environment(self, biome)
	self.current_biome = biome or "grass"
	local theme = BIOME_THEMES[self.current_biome] or BIOME_THEMES.grass

	pcall(function()
		go.set("#sky", "tint", theme.sky)
	end)
	pcall(function()
		go.set("#water", "tint", theme.water)
	end)
end

local function update_full_texture(self)
	fill_full_stream(self)
	if self.is_initialized then
		pcall(function()
			resource.set_texture(TEXTURE_PATH, {
				x = 0,
				y = 0,
				width = self.w,
				height = self.h,
				type = graphics.TEXTURE_TYPE_2D,
				format = graphics.TEXTURE_FORMAT_RGBA
			}, self.tex_buffer)
		end)
	end
end

function init(self)
	constants.log(">>> TERRAIN INIT STARTED")
	self.w = constants.TERRAIN_WIDTH
	self.h = constants.TERRAIN_HEIGHT
	self.is_initialized = false
	self.current_biome = "grass"
	self.current_preset = "hills"

	-- Water shimmer animation
	go.animate("#water", "scale.y", go.PLAYBACK_LOOP_PINGPONG, 2.15, go.EASING_INOUTSINE, 1.8)

	-- Apply initial environment
	apply_biome_environment(self, "grass")

	-- Create pixel buffer for terrain
	self.tex_buffer = buffer.create(self.w * self.h, {
		{ name = hash("rgba"), type = buffer.VALUE_TYPE_UINT8, count = 4 }
	})
	self.stream = buffer.get_stream(self.tex_buffer, hash("rgba"))

	-- Generate initial terrain
	terrain_grid.init(self.w, self.h, constants.TERRAIN_SCALE)
	terrain_grid.generate("hills")
	fill_full_stream(self)

	-- Create dynamic texture
	local t_params = {
		width = self.w,
		height = self.h,
		type = graphics.TEXTURE_TYPE_2D,
		format = graphics.TEXTURE_FORMAT_RGBA,
		num_mip_maps = 1
	}
	local ok_t, tex_res = pcall(resource.create_texture, TEXTURE_PATH, t_params, self.tex_buffer)

	-- Create dynamic atlas pointing to dynamic texture
	local atlas_params = {
		texture = TEXTURE_PATH,
		animations = {
			{
				id = "terrain",
				width = self.w,
				height = self.h,
				frames = { 1 }
			}
		},
		geometries = {
			{
				id = "terrain",
				width = self.w,
				height = self.h,
				pivot_x = 0.5,
				pivot_y = 0.5,
				vertices = { 0, 0,  0, self.h,  self.w, self.h,  self.w, 0 },
				uvs = { 0, 0,  0, self.h,  self.w, self.h,  self.w, 0 },
				indices = { 0, 1, 2,  0, 2, 3 }
			}
		}
	}
	local ok_a, atlas_res = pcall(resource.create_atlas, ATLAS_PATH, atlas_params)

	if ok_a and atlas_res then
		self.atlas_id = atlas_res
		go.set("#sprite", "image", atlas_res)
		sprite.play_flipbook("#sprite", "terrain")
		self.is_initialized = true
		constants.log(">>> TERRAIN INIT FINISHED WITH DYNAMIC ATLAS SUCCESS!")
	else
		constants.log(">>> TERRAIN ATLAS ERROR:", ok_a, tostring(atlas_res), ok_t, tostring(tex_res))
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("generate_terrain") then
		local preset = message.preset or "hills"
		local biome = message.biome
		if not biome then
			-- Match default biome to preset if not specified
			if preset == "canyon" or preset == "canyon_bridge" or preset == "bunkers" then
				biome = "desert"
			elseif preset == "floating_islands" then
				biome = "arctic"
			elseif preset == "cavern" then
				biome = "volcano"
			elseif preset == "swiss_cheese" then
				biome = "alien"
			else
				biome = "grass"
			end
		end

		self.current_preset = preset
		self.current_biome = biome
		constants.log(">>> TERRAIN ON_MESSAGE GENERATE_TERRAIN:", preset, "biome:", biome)
		apply_biome_environment(self, biome)
		if not message.already_generated then
			terrain_grid.generate(preset)
		end
		update_full_texture(self)

	elseif message_id == hash("carve_crater") then
		local cx = message.x or 0
		local cy = message.y or 0
		local r = message.radius or 30
		constants.log(">>> TERRAIN ON_MESSAGE CARVE_CRATER at:", cx, cy, "r:", r)

		local min_gx, min_gy, max_gx, max_gy, cleared = terrain_grid.carve_circle(cx, cy, r)
		if cleared > 0 and self.is_initialized then
			local sub_w = max_gx - min_gx + 1
			local sub_h = max_gy - min_gy + 1

			local sub_buf = buffer.create(sub_w * sub_h, {
				{ name = hash("rgba"), type = buffer.VALUE_TYPE_UINT8, count = 4 }
			})
			local sub_stream = buffer.get_stream(sub_buf, hash("rgba"))

			local s_idx = 1
			local grid = terrain_grid.grid
			local biome = self.current_biome or "grass"
			for gy = min_gy, max_gy do
				for gx = min_gx, max_gx do
					write_terrain_pixel(sub_stream, s_idx, gx, gy, self.w, self.h, grid, biome)
					s_idx = s_idx + 4
				end
			end

			pcall(function()
				resource.set_texture(TEXTURE_PATH, {
					x = min_gx,
					y = min_gy,
					width = sub_w,
					height = sub_h,
					type = graphics.TEXTURE_TYPE_2D,
					format = graphics.TEXTURE_FORMAT_RGBA
				}, sub_buf)
			end)
		end
	end
end
