-- main/entities/explosion/explosion.script
-- Visual blast flash and drifting smoke particle animations

local constants = require("lua_modules.constants")

go.property("radius", 30)

function init(self)
	constants.log(">>> EXPLOSION INIT RADIUS:", self.radius)
	local target_scale = (self.radius * 2.0) / 48.0 -- 48px is explosion base texture size

	-- Flash explosion ring
	go.set("#sprite", "scale", vmath.vector3(0.2, 0.2, 1.0))
	go.animate("#sprite", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(target_scale, target_scale, 1.0), go.EASING_OUTQUAD, 0.25)
	go.animate("#sprite", "tint.w", go.PLAYBACK_ONCE_FORWARD, 0.0, go.EASING_INQUAD, 0.35, 0.05)

	-- Drift smoke puffs
	go.animate("#smoke1", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(1.3, 1.3, 1.0), go.EASING_OUTQUAD, 0.45)
	go.animate("#smoke1", "tint.w", go.PLAYBACK_ONCE_FORWARD, 0.0, go.EASING_INQUAD, 0.45)

	go.animate("#smoke2", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(1.4, 1.4, 1.0), go.EASING_OUTQUAD, 0.45)
	go.animate("#smoke2", "tint.w", go.PLAYBACK_ONCE_FORWARD, 0.0, go.EASING_INQUAD, 0.45)

	-- Flying dirt & earth debris particles
	local dirt_ids = { "#dirt1", "#dirt2", "#dirt3", "#dirt4" }
	for i, d_id in ipairs(dirt_ids) do
		local angle = math.rad((i - 1) * 90 + math.random(-25, 25))
		local dist = self.radius * (0.8 + math.random() * 0.7)
		local target_x = math.cos(angle) * dist
		local target_y = math.sin(angle) * dist + math.random(5, 20)
		pcall(function()
			go.set(d_id, "scale", vmath.vector3(0.9 + math.random() * 0.5, 0.9 + math.random() * 0.5, 1.0))
			go.animate(d_id, "position.x", go.PLAYBACK_ONCE_FORWARD, target_x, go.EASING_OUTQUAD, 0.42)
			go.animate(d_id, "position.y", go.PLAYBACK_ONCE_FORWARD, target_y - 25, go.EASING_INQUAD, 0.42)
			go.animate(d_id, "tint.w", go.PLAYBACK_ONCE_FORWARD, 0.0, go.EASING_INQUAD, 0.42, 0.1)
		end)
	end

	-- High-speed oil & fire sparks
	local spark_ids = { "#spark1", "#spark2", "#spark3", "#spark4" }
	for i, s_id in ipairs(spark_ids) do
		local angle = math.rad((i - 1) * 90 + 45 + math.random(-20, 20))
		local dist = self.radius * (1.1 + math.random() * 0.8)
		local target_x = math.cos(angle) * dist
		local target_y = math.sin(angle) * dist + math.random(10, 30)
		pcall(function()
			go.set(s_id, "scale", vmath.vector3(1.2, 1.2, 1.0))
			go.animate(s_id, "position.x", go.PLAYBACK_ONCE_FORWARD, target_x, go.EASING_OUTEXPO, 0.35)
			go.animate(s_id, "position.y", go.PLAYBACK_ONCE_FORWARD, target_y, go.EASING_OUTQUAD, 0.35)
			go.animate(s_id, "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(0.1, 0.1, 1.0), go.EASING_INQUAD, 0.35)
			go.animate(s_id, "tint.w", go.PLAYBACK_ONCE_FORWARD, 0.0, go.EASING_INQUAD, 0.35)
		end)
	end

	-- Delete object after all animations settle
	timer.delay(0.48, false, function()
		go.delete()
	end)
end
