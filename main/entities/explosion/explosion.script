-- main/entities/explosion/explosion.script
-- Visual blast flash and drifting smoke particle animations

local constants = require("lua_modules.constants")

go.property("radius", 30)

function init(self)
	constants.log(">>> EXPLOSION INIT RADIUS:", self.radius)
	local target_scale = (self.radius * 2.0) / 48.0 -- 48px is explosion base texture size

	-- Flash explosion ring
	go.set("#sprite", "scale", vmath.vector3(0.2, 0.2, 1.0))
	go.animate("#sprite", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(target_scale, target_scale, 1.0), go.EASING_OUTQUAD, 0.25)
	go.animate("#sprite", "tint.w", go.PLAYBACK_ONCE_FORWARD, 0.0, go.EASING_INQUAD, 0.35, 0.05)

	-- Drift smoke puffs
	go.animate("#smoke1", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(1.3, 1.3, 1.0), go.EASING_OUTQUAD, 0.45)
	go.animate("#smoke1", "tint.w", go.PLAYBACK_ONCE_FORWARD, 0.0, go.EASING_INQUAD, 0.45)

	go.animate("#smoke2", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(1.4, 1.4, 1.0), go.EASING_OUTQUAD, 0.45)
	go.animate("#smoke2", "tint.w", go.PLAYBACK_ONCE_FORWARD, 0.0, go.EASING_INQUAD, 0.45, 0, function()
		go.delete()
	end)
end
