-- main/entities/potato/potato.script
-- Controls potato visuals, health bar, weapon attachment, and states

go.property("team", 1)
go.property("potato_id", 1)
go.property("hp", 100)
go.property("max_hp", 100)
go.property("facing", 1)

local function update_hp_bar(self)
	local pct = math.max(0, math.min(1.0, self.hp / self.max_hp))

	go.set("#hp_fill", "scale", vmath.vector3(3.8 * pct, 0.5, 1.0))

	-- Tint health bar based on percentage
	local color
	if pct > 0.55 then
		color = vmath.vector4(0.18, 0.80, 0.44, 1.0) -- Green
	elseif pct > 0.25 then
		color = vmath.vector4(0.95, 0.77, 0.06, 1.0) -- Yellow
	else
		color = vmath.vector4(0.91, 0.30, 0.24, 1.0) -- Red
	end
	go.set("#hp_fill", "tint", color)
end

local function update_facing(self, facing)
	self.facing = (facing >= 0) and 1 or -1
	local flip = (self.facing < 0)
	sprite.set_hflip("#sprite", flip)
	sprite.set_hflip("#weapon_sprite", flip)
end

local WEAPON_SPRITE_MAP = {
	grenade = "grenade",
	rifle = "skewer_rifle",
	knife = "peeler",
	molotov = "oil_bottle",
	burst = "rifle",
	bazooka = "masher_bazooka",
	shotgun = "grater",
	holy_grenade = "holy_spud",
}

function init(self)
	self.is_alive = (self.hp > 0)
	self.is_active = false
	self.hp_bar_timer = 0
	self.alert_timer = 0
	self.skin_tint = vmath.vector4(1, 1, 1, 1)

	-- Setup team appearance
	local anim = (self.team == 1) and hash("potato_blue") or hash("potato_red")
	sprite.play_flipbook("#sprite", anim)

	-- Apply initial facing
	update_facing(self, self.facing or 1)

	-- Setup health bar colors
	go.set("#hp_bg", "tint", vmath.vector4(0.12, 0.15, 0.18, 0.5))
	update_hp_bar(self)

	-- Hide HP bar by default, show on damage/heal or when active
	msg.post("#hp_bg", "disable")
	msg.post("#hp_fill", "disable")

	-- Hide reticle by default
	msg.post("#reticle", "disable")

	-- Subtle pulse animation on reticle
	go.animate("#reticle", "scale", go.PLAYBACK_LOOP_PINGPONG, vmath.vector3(0.68, 0.68, 1.0), go.EASING_INOUTSINE, 0.45)
	self.breath_timer = math.random() * 6.28
	self.scale_anim_timer = 0
end

function update(self, dt)
	if self.scale_anim_timer and self.scale_anim_timer > 0 then
		self.scale_anim_timer = self.scale_anim_timer - dt
	elseif self.is_alive then
		self.breath_timer = (self.breath_timer or 0) + dt * (self.is_active and 4.2 or 2.6)
		local s = math.sin(self.breath_timer) * (self.is_active and 0.045 or 0.025)
		go.set("#sprite", "scale", vmath.vector3(1.0 - s * 0.7, 1.0 + s, 1.0))
	end

	if self.hp_bar_timer > 0 then
		self.hp_bar_timer = self.hp_bar_timer - dt
		if self.hp_bar_timer <= 0 then
			msg.post("#hp_bg", "disable")
			msg.post("#hp_fill", "disable")
		end
	end

	if self.alert_timer > 0 then
		self.alert_timer = self.alert_timer - dt
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("alert_aimed") then
		if self.is_alive and not self.is_active and self.alert_timer <= 0 then
			self.alert_timer = 1.0
			self.scale_anim_timer = 0.22
			-- Quick nervous shudder animation
			go.animate("#sprite", "scale.y", go.PLAYBACK_ONCE_PINGPONG, 0.80, go.EASING_INOUTSINE, 0.18)
			go.animate("#sprite", "tint", go.PLAYBACK_ONCE_PINGPONG, vmath.vector4(1.3, 0.7, 0.7, 1.0), go.EASING_OUTQUAD, 0.22, 0, function()
				go.set("#sprite", "tint", self.skin_tint)
			end)
		end
	elseif message_id == hash("set_active") then
		self.is_active = message.active
		if self.is_alive and self.is_active then
			msg.post("#reticle", "enable")
			msg.post("#hp_bg", "enable")
			msg.post("#hp_fill", "enable")
			self.hp_bar_timer = 0 -- keep showing while active
		else
			msg.post("#reticle", "disable")
			self.hp_bar_timer = 2.0 -- fade out after 2 seconds
		end

	elseif message_id == hash("set_skin") then
		if message.tint then
			self.skin_tint = vmath.vector4(message.tint[1] or 1, message.tint[2] or 1, message.tint[3] or 1, message.tint[4] or 1)
			go.set("#sprite", "tint", self.skin_tint)
		end

	elseif message_id == hash("set_weapon") then
		if self.is_alive and message.weapon_id then
			local w_id = tostring(message.weapon_id)
			local sprite_name = WEAPON_SPRITE_MAP[w_id] or "grenade"
			pcall(function()
				sprite.play_flipbook("#weapon_sprite", hash(sprite_name))
				local flip = (self.facing < 0)
				sprite.set_hflip("#weapon_sprite", flip)
			end)
		end

	elseif message_id == hash("set_facing") then
		if message.facing then
			update_facing(self, message.facing)
		end

	elseif message_id == hash("apply_heal") then
		if not self.is_alive then
			return
		end

		local heal_amt = message.amount or 0
		self.hp = math.min(self.max_hp, self.hp + heal_amt)
		update_hp_bar(self)

		-- Show HP bar
		msg.post("#hp_bg", "enable")
		msg.post("#hp_fill", "enable")
		self.hp_bar_timer = 3.0

		-- Green pulse animation on sprite
		go.set("#sprite", "tint", vmath.vector4(0.3, 2.0, 0.5, 1.0))
		go.animate("#sprite", "tint", go.PLAYBACK_ONCE_FORWARD, self.skin_tint, go.EASING_OUTQUAD, 0.4)

	elseif message_id == hash("on_jump") then
		if self.is_alive then
			self.scale_anim_timer = 0.25
			-- Vertical stretch on jump
			go.animate("#sprite", "scale", go.PLAYBACK_ONCE_PINGPONG, vmath.vector3(0.76, 1.32, 1.0), go.EASING_OUTQUAD, 0.24)
		end

	elseif message_id == hash("on_land") then
		if self.is_alive then
			self.scale_anim_timer = 0.28
			-- Juicy bounce squash on landing
			go.animate("#sprite", "scale", go.PLAYBACK_ONCE_PINGPONG, vmath.vector3(1.32, 0.68, 1.0), go.EASING_OUTBOUNCE, 0.26)
		end

	elseif message_id == hash("on_recoil") then
		if self.is_alive then
			self.scale_anim_timer = 0.18
			-- Weapon kick recoil
			go.animate("#weapon_sprite", "scale", go.PLAYBACK_ONCE_PINGPONG, vmath.vector3(0.55, 0.55, 1.0), go.EASING_OUTQUAD, 0.12)
			go.animate("#sprite", "scale", go.PLAYBACK_ONCE_PINGPONG, vmath.vector3(1.18, 0.86, 1.0), go.EASING_OUTQUAD, 0.15)
		end

	elseif message_id == hash("apply_damage") then
		if not self.is_alive then
			return
		end

		self.hp = math.max(0, self.hp - (message.damage or 0))
		update_hp_bar(self)

		-- Show HP bar on damage
		msg.post("#hp_bg", "enable")
		msg.post("#hp_fill", "enable")
		self.hp_bar_timer = 3.0
		self.scale_anim_timer = 0.22

		-- Flash white on hit and juicy impact squash
		go.animate("#sprite", "scale", go.PLAYBACK_ONCE_PINGPONG, vmath.vector3(1.30, 0.72, 1.0), go.EASING_INOUTSINE, 0.20)
		go.animate("#sprite", "tint", go.PLAYBACK_ONCE_PINGPONG, vmath.vector4(2.2, 0.6, 0.6, 1), go.EASING_OUTQUAD, 0.16, 0, function()
			go.set("#sprite", "tint", self.skin_tint)
		end)

		if self.hp <= 0 then
			self.is_alive = false
			-- Turn into potato grave/tombstone
			sprite.play_flipbook("#sprite", hash("tombstone"))
			go.set("#sprite", "tint", vmath.vector4(1, 1, 1, 1))
			msg.post("#reticle", "disable")
			msg.post("#weapon_sprite", "disable")
			msg.post("#hp_bg", "disable")
			msg.post("#hp_fill", "disable")
		end

	elseif message_id == hash("drowned") then
		self.is_alive = false
		self.hp = 0
		msg.post("#reticle", "disable")
		msg.post("#weapon_sprite", "disable")
		msg.post("#hp_bg", "disable")
		msg.post("#hp_fill", "disable")
		-- Sinks into water
		go.animate(".", "position.y", go.PLAYBACK_ONCE_FORWARD, -40, go.EASING_INQUAD, 0.5, 0, function()
			go.delete()
		end)
	end
end
