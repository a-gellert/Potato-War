-- main/entities/potato/potato.script
-- Controls potato visuals, health bar, weapon attachment, elemental statuses, and DoT effects

local weapons = require("lua_modules.weapons")
local i18n = require("lua_modules.i18n")
local sound_manager = require("lua_modules.sound_manager")
local classes = require("lua_modules.classes")

local STEP_SOUND_EVERY = 0.26

go.property("team", 1)
go.property("potato_id", 1)
go.property("hp", 100)
go.property("max_hp", 100)
go.property("facing", 1)

-- Held weapon + gloves live in a child game object (main/entities/weapon_rig)
local function rig_post(self, message_id, message)
	if self.rig then
		msg.post(msg.url(nil, self.rig, "weapon_rig"), message_id, message)
	end
end

local function update_hp_bar(self)
	local pct = math.max(0, math.min(1.0, self.hp / self.max_hp))

	-- Compact shoulder-width HP bar (~34px wide)
	local total_w = 2.05
	local cur_w = total_w * pct
	local offset_x = -((total_w - cur_w) * 16.0) * 0.5
	go.set("#hp_fill", "scale", vmath.vector3(cur_w, 0.38, 1.0))
	go.set("#hp_fill", "position", vmath.vector3(offset_x, 38.75, 0.09))

	-- Crisp white HP counter inside bar
	pcall(function()
		label.set_text("#hp_text", string.format("%d/%d", math.max(0, math.floor(self.hp)), math.floor(self.max_hp)))
	end)

	-- HP bar color distinguishes the team!
	local team_hp_color
	if self.team == 1 then
		-- Blue Team: Soft Serene Cyan
		team_hp_color = vmath.vector4(0.15, 0.78, 0.95, 1.0)
	else
		-- Red Team: Vivid Soft Coral
		team_hp_color = vmath.vector4(0.96, 0.35, 0.48, 1.0)
	end
	go.set("#hp_fill", "tint", team_hp_color)
end

local EMOTION_MAP = {
	idle       = "s_bored",
	bored      = "s_bored",
	bored2     = "s_bored2",
	aim        = "s_angry",
	angry      = "s_angry",
	angry2     = "s_angry2",
	hurt       = "s_angry2",
	damage     = "s_angry2",
	happy      = "s_happy",
	shoot      = "s_happy",
	heal       = "s_happy",
	jump       = "s_wow",
	wow        = "s_wow",
	scared     = "s_wow",
	alert      = "s_wow",
}

local function set_emotion(self, emotion_id, duration)
	if not self.is_alive and not self.is_dying then return end
	self.current_emotion = emotion_id or "idle"
	local anim = EMOTION_MAP[self.current_emotion] or self.current_emotion or "s_bored"
	local ok, err = pcall(function()
		msg.post("#emotion", "enable")
		sprite.play_flipbook("#emotion", hash(anim))
		local flip = (self.facing < 0)
		sprite.set_hflip("#emotion", flip)
	end)
	if not ok and err then
		print("EMOTION ERROR:", err, "anim:", anim)
	end
	if duration and duration > 0 then
		self.emotion_timer = duration
	else
		self.emotion_timer = 0
	end
end

local function set_hat(self, hat_id)
	self.hat_id = hat_id or "none"
	if not self.is_alive or self.hat_id == "none" or self.hat_id == "" then
		pcall(function() msg.post("#hat_sprite", "disable") end)
	else
		pcall(function()
			sprite.play_flipbook("#hat_sprite", hash(self.hat_id))
			msg.post("#hat_sprite", "enable")
			local flip = (self.facing < 0)
			sprite.set_hflip("#hat_sprite", flip)
		end)
	end
end

local function update_facing(self, facing)
	self.facing = (facing >= 0) and 1 or -1
	local flip = (self.facing < 0)
	sprite.set_hflip("#sprite", flip)
	rig_post(self, "set_facing", { facing = self.facing })
	sprite.set_hflip("#emotion", flip)
	if self.hat_id and self.hat_id ~= "none" then
		sprite.set_hflip("#hat_sprite", flip)
	end
end

local function update_class_sprite(self)
	local sprite_name = classes.sprite_of(self.class_id)
	pcall(function()
		sprite.play_flipbook("#sprite", hash(sprite_name))
	end)
end

local function has_active_status(self, st)
	return self.statuses and self.statuses[st] and (self.statuses[st].duration or 0) > 0
end

local function clean_expired_statuses(self)
	if not self.statuses then return end
	for k, v in pairs(self.statuses) do
		if not v or (v.duration or 0) <= 0 then
			self.statuses[k] = nil
		end
	end
end

function init(self)
	self.rig = factory.create("#rig_factory", nil, nil, {}, 1)
	go.set_parent(self.rig, go.get_id(), false)
	go.set_position(vmath.vector3(3, -2, 0), self.rig)

	self.is_alive = (self.hp > 0)
	self.is_dying = false
	self.is_dead = false
	self.is_active = false
	self.hp_bar_timer = 0
	self.alert_timer = 0
	self.skin_tint = vmath.vector4(1, 1, 1, 1)
	self.statuses = {} -- burning, poisoned, glued, concussed
	self.class_id = "recruit"
	self.hat_id = "none"
	self.current_emotion = "idle"
	self.emotion_timer = 0

	-- Setup class appearance (natural potato color, no colored tint)
	update_class_sprite(self)

	-- Apply initial facing
	update_facing(self, self.facing or 1)

	-- Setup face & emotion
	set_emotion(self, "idle")

	-- Initial hat hidden until equipped
	pcall(function() msg.post("#hat_sprite", "disable") end)

	-- Setup health bar colors (background dark slate)
	go.set("#hp_bg", "tint", vmath.vector4(1.0, 1.0, 1.0, 0.95))
	update_hp_bar(self)

	-- Always keep HP bar enabled above every potato fighter in their team color
	msg.post("#hp_bg", "enable")
	msg.post("#hp_fill", "enable")
	pcall(function() msg.post("#hp_text", "enable") end)

	-- Hide weapon, reticle, and hit sparks by default until active
	rig_post(self, "hide")
	msg.post("#reticle", "disable")
	pcall(function()
		msg.post("#hit_spark1", "disable")
		msg.post("#hit_spark2", "disable")
	end)

	-- Subtle pulse animation on reticle
	go.animate("#reticle", "scale", go.PLAYBACK_LOOP_PINGPONG, vmath.vector3(0.68, 0.68, 1.0), go.EASING_INOUTSINE, 0.45)
	self.breath_timer = math.random() * 6.28
	self.scale_anim_timer = 0
end

local BASE_SCALE = 0.3125

function update(self, dt)
	if self.scale_anim_timer and self.scale_anim_timer > 0 then
		self.scale_anim_timer = self.scale_anim_timer - dt
	elseif (self.is_alive or self.is_dying) and not self.is_dead then
		self.breath_timer = (self.breath_timer or 0) + dt * (self.is_active and 4.2 or 2.6)
		local s = math.sin(self.breath_timer) * (self.is_active and 0.045 or 0.025)
		go.set("#sprite", "scale", vmath.vector3(BASE_SCALE * (1.0 - s * 0.7), BASE_SCALE * (1.0 + s), 1.0))
	end

	-- Emotion timer expiration
	if self.emotion_timer and self.emotion_timer > 0 then
		self.emotion_timer = self.emotion_timer - dt
		if self.emotion_timer <= 0 then
			local default_expr = self.is_active and "aim" or "idle"
			set_emotion(self, default_expr)
		end
	end

	-- Visual representation of elemental status effects above / on the fighter
	if self.is_alive then
		if has_active_status(self, "burning") then
			-- Fiery flame flicker & shudder
			local flame = 0.35 * math.sin(self.breath_timer * 12.0)
			go.set("#sprite", "tint", vmath.vector4(1.9 + flame, 0.65 - flame * 0.5, 0.25, 1.0))
		elseif has_active_status(self, "poisoned") then
			-- Sickly toxic glow
			local tox = 0.25 * math.sin(self.breath_timer * 8.0)
			go.set("#sprite", "tint", vmath.vector4(0.45, 1.75 + tox, 0.35, 1.0))
		elseif has_active_status(self, "glued") then
			-- Sticky thick amber/yellow coat
			go.set("#sprite", "tint", vmath.vector4(1.4, 1.35, 0.35, 1.0))
		elseif has_active_status(self, "concussed") then
			-- Dizzy wobble / stun rotation
			local wobble = math.sin(self.breath_timer * 10.0) * 0.12
			go.set_rotation(vmath.quat_rotation_z(wobble))
			go.set("#sprite", "tint", vmath.vector4(0.85, 0.85, 1.5, 1.0))
		else
			-- Normal skin tint
			go.set_rotation(vmath.quat_rotation_z(0))
			go.set("#sprite", "tint", self.skin_tint)
		end
	end

	if self.alert_timer > 0 then
		self.alert_timer = self.alert_timer - dt
	end
end

-- Process Turn-Start DoT and Debuffs
local function process_turn_start(self)
	if not self.is_alive then return end

	local p_pos = go.get_position()
	local took_dot = false

	-- 1. Burning DoT
	if has_active_status(self, "burning") then
		local burn_data = self.statuses.burning
		local dmg = burn_data.power or 14
		self.hp = math.max(0, self.hp - dmg)
		update_hp_bar(self)
		took_dot = true

		msg.post("/gui_hud#gui", "show_damage", {
			x = p_pos.x,
			y = p_pos.y + 16,
			amount = dmg,
			status = "burning",
			label = i18n.pick({ ru = "ОЖОГ", en = "BURN", pt = "QUEIMADURA", fr = "BRÛLURE", es = "QUEMADURA", tr = "YANIK" })
		})

		burn_data.duration = (burn_data.duration or 1) - 1
		if burn_data.duration <= 0 then
			self.statuses.burning = nil
		end
	end

	-- 2. Poisoned DoT
	if self.is_alive and has_active_status(self, "poisoned") then
		local poison_data = self.statuses.poisoned
		local dmg = poison_data.power or 10
		self.hp = math.max(0, self.hp - dmg)
		update_hp_bar(self)
		took_dot = true

		msg.post("/gui_hud#gui", "show_damage", {
			x = p_pos.x,
			y = p_pos.y + 16,
			amount = dmg,
			status = "poisoned",
			label = i18n.pick({ ru = "ЯД", en = "POISON", pt = "VENENO", fr = "POISON", es = "VENENO", tr = "ZEHİR" })
		})

		poison_data.duration = (poison_data.duration or 1) - 1
		if poison_data.duration <= 0 then
			self.statuses.poisoned = nil
		end
	end

	-- 3. Glued notification
	if self.is_alive and has_active_status(self, "glued") then
		msg.post("/gui_hud#gui", "show_damage", {
			x = p_pos.x,
			y = p_pos.y + 24,
			amount = 0,
			status = "glued",
			label = i18n.pick({ ru = "КЛЕЙ", en = "GLUE", pt = "COLA", fr = "COLLE", es = "PEGAMENTO", tr = "YAPIŞKAN" })
		})
	end

	-- 4. Concussed notification
	if self.is_alive and has_active_status(self, "concussed") then
		msg.post("/gui_hud#gui", "show_damage", {
			x = p_pos.x,
			y = p_pos.y + 24,
			amount = 0,
			status = "concussed",
			label = i18n.pick({ ru = "ОГЛУШЕНИЕ", en = "STUN", pt = "ATORDOADO", fr = "ÉTOURDI", es = "ATURDIDO", tr = "SERSEMLEDİ" })
		})
	end

	if took_dot then
		msg.post("#hp_bg", "enable")
		msg.post("#hp_fill", "enable")
		pcall(function() msg.post("#hp_text", "enable") end)
		self.hp_bar_timer = 3.0

		if self.hp <= 0 then
			self.is_alive = false
			self.is_dying = true
			msg.post("#reticle", "disable")
			rig_post(self, "hide")
			set_emotion(self, "hurt", 1.4)
			sound_manager.play("hurt", { vary = 0.1 })
			timer.delay(0.35, false, function()
				msg.post(".", "die")
			end)
		end
	end
end

-- Process Turn-End Debuffs & Expirations
local function process_turn_end(self)
	if not self.is_alive then return end

	-- Decrement glued and concussed durations at end of turn
	if has_active_status(self, "glued") then
		self.statuses.glued.duration = self.statuses.glued.duration - 1
		if self.statuses.glued.duration <= 0 then
			self.statuses.glued = nil
		end
	end

	if has_active_status(self, "concussed") then
		self.statuses.concussed.duration = self.statuses.concussed.duration - 1
		if self.statuses.concussed.duration <= 0 then
			self.statuses.concussed = nil
		end
	end

	clean_expired_statuses(self)
end

function on_message(self, message_id, message, sender)
	if message_id == hash("alert_aimed") then
		if self.is_alive and not self.is_active and self.alert_timer <= 0 then
			self.alert_timer = 1.0
			self.scale_anim_timer = 0.22
			set_emotion(self, "scared", 1.2)
			go.animate("#sprite", "scale.y", go.PLAYBACK_ONCE_PINGPONG, BASE_SCALE * 0.80, go.EASING_INOUTSINE, 0.18)
			go.animate("#sprite", "tint", go.PLAYBACK_ONCE_PINGPONG, vmath.vector4(1.3, 0.7, 0.7, 1.0), go.EASING_OUTQUAD, 0.22, 0, function()
				go.set("#sprite", "tint", self.skin_tint)
			end)
		end

	elseif message_id == hash("set_active") then
		self.is_active = message.active
		if self.is_alive and self.is_active then
			msg.post("#reticle", "enable")
			rig_post(self, "show")
			set_emotion(self, "aim")
		else
			msg.post("#reticle", "disable")
			rig_post(self, "hide")
			set_emotion(self, "idle")
		end

	elseif message_id == hash("set_emotion") then
		if message.emotion then
			set_emotion(self, message.emotion, message.duration)
		end

	elseif message_id == hash("set_hat") then
		set_hat(self, message.hat)

	elseif message_id == hash("set_skin") then
		if message.hat then
			set_hat(self, message.hat)
		end
		if message.tint then
			self.skin_tint = vmath.vector4(message.tint[1] or 1, message.tint[2] or 1, message.tint[3] or 1, message.tint[4] or 1)
			rig_post(self, "set_tint", { tint = self.skin_tint })
			go.set("#sprite", "tint", self.skin_tint)
		end

	elseif message_id == hash("set_class") then
		if message.class_id then
			self.class_id = message.class_id
			update_class_sprite(self)
		end

	elseif message_id == hash("set_weapon") then
		if self.is_alive and message.weapon_id then
			rig_post(self, "set_weapon", { weapon_id = tostring(message.weapon_id) })
			if self.is_active then
				rig_post(self, "show")
			end
		end

	elseif message_id == hash("set_aim") then
		rig_post(self, "set_aim", { vx = message.vx, vy = message.vy })

	elseif message_id == hash("set_facing") then
		if message.facing then
			update_facing(self, message.facing)
		end

	elseif message_id == hash("on_step") then
		local now = socket.gettime()
		if self.is_alive and now - (self.last_step_sound or 0) > STEP_SOUND_EVERY then
			self.last_step_sound = now
			sound_manager.play("step", { vary = 0.2 })
		end
		if self.is_alive and (not self.scale_anim_timer or self.scale_anim_timer <= 0) then
			-- Quick squish-and-stretch on walking hop
			local hop_val = message.hop or 0.5
			local sx = BASE_SCALE * (1.0 - (hop_val - 0.5) * 0.16)
			local sy = BASE_SCALE * (1.0 + (hop_val - 0.5) * 0.16)
			go.set("#sprite", "scale", vmath.vector3(sx, sy, 1.0))
		end

	elseif message_id == hash("apply_heal") then
		if not self.is_alive then return end

		local heal_amt = message.amount or 0
		self.hp = math.min(self.max_hp, self.hp + heal_amt)
		update_hp_bar(self)
		set_emotion(self, "happy", 1.8)

		msg.post("#hp_bg", "enable")
		msg.post("#hp_fill", "enable")
		self.hp_bar_timer = 3.0

		go.set("#sprite", "tint", vmath.vector4(0.3, 2.0, 0.5, 1.0))
		go.animate("#sprite", "tint", go.PLAYBACK_ONCE_FORWARD, self.skin_tint, go.EASING_OUTQUAD, 0.4)

	elseif message_id == hash("apply_status") then
		if not self.is_alive then return end

		local st_type = message.status or "burning"
		local duration = message.duration or 2
		local power = message.power or 10
		local p_pos = go.get_position()
		set_emotion(self, "hurt", 1.2)

		-- Check elemental combo with existing statuses
		local combo = weapons.eval_combo(self.statuses, st_type)
		if combo then
			-- Combo triggered!
			if combo.bonus_damage and combo.bonus_damage > 0 then
				self.hp = math.max(0, self.hp - combo.bonus_damage)
				update_hp_bar(self)
				msg.post("/gui_hud#gui", "show_damage", {
					x = p_pos.x,
					y = p_pos.y + 24,
					amount = combo.bonus_damage,
					status = "combo",
					label = i18n.field(combo, "name")
				})
			end
			if combo.duration_bonus then
				duration = duration + combo.duration_bonus
			end
		else
			-- Show status overhead icon/label
			local label_map = {
				burning   = i18n.pick({ ru = "ОЖОГ!", en = "BURN!", pt = "QUEIMADURA!", fr = "BRÛLURE !", es = "¡QUEMADURA!", tr = "YANIK!" }),
				poisoned  = i18n.pick({ ru = "ЯД!", en = "POISON!", pt = "VENENO!", fr = "POISON !", es = "¡VENENO!", tr = "ZEHİR!" }),
				glued     = i18n.pick({ ru = "КЛЕЙ!", en = "GLUE!", pt = "COLA!", fr = "COLLE !", es = "¡PEGAMENTO!", tr = "YAPIŞKAN!" }),
				concussed = i18n.pick({ ru = "ОГЛУШЕН!", en = "STUNNED!", pt = "ATORDOADO!", fr = "ÉTOURDI !", es = "¡ATURDIDO!", tr = "SERSEMLEDİ!" }),
			}
			msg.post("/gui_hud#gui", "show_damage", {
				x = p_pos.x,
				y = p_pos.y + 20,
				amount = 0,
				status = st_type,
				label = label_map[st_type] or st_type
			})
		end

		self.statuses[st_type] = {
			duration = duration,
			power = power,
		}

	elseif message_id == hash("remove_status") then
		if message.status and self.statuses then
			self.statuses[message.status] = nil
		end

	elseif message_id == hash("clear_statuses") then
		self.statuses = {}
		go.set_rotation(vmath.quat_rotation_z(0))
		go.set("#sprite", "tint", self.skin_tint)

	elseif message_id == hash("on_turn_start") then
		process_turn_start(self)

	elseif message_id == hash("on_turn_end") then
		process_turn_end(self)

	elseif message_id == hash("on_jump") then
		if self.is_alive then
			sound_manager.play("jump", { vary = 0.1 })
			self.scale_anim_timer = 0.25
			set_emotion(self, "jump", 0.6)
			go.animate("#sprite", "scale", go.PLAYBACK_ONCE_PINGPONG, vmath.vector3(BASE_SCALE * 0.76, BASE_SCALE * 1.32, 1.0), go.EASING_OUTQUAD, 0.24)
		end

	elseif message_id == hash("on_land") then
		if self.is_alive or self.is_dying then
			sound_manager.play("land", { vary = 0.1 })
			self.scale_anim_timer = 0.28
			go.animate("#sprite", "scale", go.PLAYBACK_ONCE_PINGPONG, vmath.vector3(BASE_SCALE * 1.32, BASE_SCALE * 0.68, 1.0), go.EASING_OUTBOUNCE, 0.26)
		end

	elseif message_id == hash("on_recoil") or message_id == hash("hide_weapon") then
		if self.is_alive then
			self.scale_anim_timer = 0.18
			if message_id == hash("hide_weapon") then
				rig_post(self, "hide")
			else
				rig_post(self, "fire")
			end
			set_emotion(self, "happy", 1.5)
			go.animate("#sprite", "scale", go.PLAYBACK_ONCE_PINGPONG, vmath.vector3(BASE_SCALE * 1.18, BASE_SCALE * 0.86, 1.0), go.EASING_OUTQUAD, 0.15)
		end

	elseif message_id == hash("apply_damage") then
		if not self.is_alive and not self.is_dying then return end

		self.hp = math.max(0, self.hp - (message.damage or 0))
		update_hp_bar(self)
		sound_manager.play("hurt", { vary = 0.1 })

		msg.post("#hp_bg", "enable")
		msg.post("#hp_fill", "enable")
		pcall(function() msg.post("#hp_text", "enable") end)
		self.hp_bar_timer = 3.0
		self.scale_anim_timer = 0.22
		set_emotion(self, "hurt", 1.4)

		go.animate("#sprite", "scale", go.PLAYBACK_ONCE_PINGPONG, vmath.vector3(BASE_SCALE * 1.30, BASE_SCALE * 0.72, 1.0), go.EASING_INOUTSINE, 0.20)
		go.animate("#sprite", "tint", go.PLAYBACK_ONCE_PINGPONG, vmath.vector4(2.2, 0.6, 0.6, 1), go.EASING_OUTQUAD, 0.16, 0, function()
			if not self.is_dead then
				go.set("#sprite", "tint", self.skin_tint)
			end
		end)

		-- Particle burst: potato crumbs & hit sparks
		pcall(function()
			msg.post("#hit_spark1", "enable")
			msg.post("#hit_spark2", "enable")
			go.set("#hit_spark1", "tint", vmath.vector4(1.8, 1.5, 0.4, 1.0))
			go.set("#hit_spark2", "tint", vmath.vector4(1.4, 0.9, 0.4, 1.0))
			go.set("#hit_spark1", "scale", vmath.vector3(1.2, 1.2, 1.0))
			go.set("#hit_spark2", "scale", vmath.vector3(1.0, 1.0, 1.0))
			local ox1 = (math.random() - 0.5) * 36
			local oy1 = math.random(10, 32)
			local ox2 = (math.random() - 0.5) * 32
			local oy2 = math.random(8, 28)
			go.set("#hit_spark1", "position", vmath.vector3(0, 4, 0.2))
			go.set("#hit_spark2", "position", vmath.vector3(0, 4, 0.2))
			go.animate("#hit_spark1", "position.x", go.PLAYBACK_ONCE_FORWARD, ox1, go.EASING_OUTEXPO, 0.35)
			go.animate("#hit_spark1", "position.y", go.PLAYBACK_ONCE_FORWARD, oy1, go.EASING_OUTQUAD, 0.35)
			go.animate("#hit_spark1", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(0.1, 0.1, 1.0), go.EASING_INQUAD, 0.35)
			go.animate("#hit_spark1", "tint.w", go.PLAYBACK_ONCE_FORWARD, 0.0, go.EASING_INQUAD, 0.35, 0, function()
				msg.post("#hit_spark1", "disable")
			end)
			go.animate("#hit_spark2", "position.x", go.PLAYBACK_ONCE_FORWARD, ox2, go.EASING_OUTQUAD, 0.38)
			go.animate("#hit_spark2", "position.y", go.PLAYBACK_ONCE_FORWARD, oy2 - 16, go.EASING_INQUAD, 0.38)
			go.animate("#hit_spark2", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(0.1, 0.1, 1.0), go.EASING_INQUAD, 0.38)
			go.animate("#hit_spark2", "tint.w", go.PLAYBACK_ONCE_FORWARD, 0.0, go.EASING_INQUAD, 0.38, 0, function()
				msg.post("#hit_spark2", "disable")
			end)
		end)

		if self.hp <= 0 then
			self.is_alive = false
			self.is_dying = true
			msg.post("#reticle", "disable")
			rig_post(self, "hide")
		end

	elseif message_id == hash("die") then
		if self.is_dead then return end
		self.is_alive = false
		self.is_dying = false
		self.is_dead = true

		sound_manager.play("death", { vary = 0.08 })
		go.cancel_animations("#sprite", "scale")
		go.cancel_animations("#sprite", "tint")
		sprite.play_flipbook("#sprite", hash("tombstone"))
		go.set("#sprite", "scale", vmath.vector3(1.35, 1.35, 1.0))
		go.set("#sprite", "tint", vmath.vector4(1, 1, 1, 1))
		go.set_rotation(vmath.quat_rotation_z(0))
		msg.post("#reticle", "disable")
		rig_post(self, "hide")
		msg.post("#emotion", "disable")
		msg.post("#hat_sprite", "disable")
		msg.post("#hp_bg", "disable")
		msg.post("#hp_fill", "disable")
		pcall(function() msg.post("#hp_text", "disable") end)

	elseif message_id == hash("drowned") then
		self.is_alive = false
		self.is_dying = false
		self.is_dead = true
		self.hp = 0
		msg.post("#reticle", "disable")
		rig_post(self, "hide")
		msg.post("#emotion", "disable")
		msg.post("#hat_sprite", "disable")
		msg.post("#hp_bg", "disable")
		msg.post("#hp_fill", "disable")
		pcall(function() msg.post("#hp_text", "disable") end)
		go.animate(".", "position.y", go.PLAYBACK_ONCE_FORWARD, -40, go.EASING_INQUAD, 0.5, 0, function()
			go.delete()
		end)
	end
end

function final(self)
	if self.rig then
		pcall(go.delete, self.rig, true)
	end
end
