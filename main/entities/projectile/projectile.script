-- main/entities/projectile/projectile.script
-- Simulates projectile flight, bounce, detonation, and damage application

local constants = require("lua_modules.constants")
local weapons = require("lua_modules.weapons")
local physics_sim = require("lua_modules.physics_sim")
local terrain_grid = require("lua_modules.terrain_grid")
local camera_controller = require("lua_modules.camera_controller")
local game_state = require("lua_modules.game_state")
local achievements = require("lua_modules.achievements")
local i18n = require("lua_modules.i18n")
local sound_manager = require("lua_modules.sound_manager")
local progression = require("lua_modules.progression")

go.property("vel_x", 0)
go.property("vel_y", 0)
go.property("weapon_type", hash("grenade"))
go.property("owner_id", 0)
go.property("target_id", 0)

local FUSE_SOUND_EVERY = 0.55
local BLINK_LAST = 1.2 -- fused bombs blink red in their last seconds

local function find_potato(id)
	for _, p in ipairs(game_state.potatoes) do
		if p.id == id then
			return p
		end
	end
	return nil
end

function init(self)
	local WEAPON_HASHES = {}
	for _, w in ipairs(weapons.LIST) do
		WEAPON_HASHES[hash(w.id)] = w.id
	end

	local w_id = WEAPON_HASHES[self.weapon_type] or "grenade"

	self.weapon = weapons.get(w_id)

	-- Weapon levels (progression): a per-shot view of the weapon with boosted damage and radius
	self.owner = find_potato(self.owner_id)
	local level = self.owner and progression.battle_weapon_level(w_id, self.owner.team, game_state.battle) or 1
	if level > 1 then
		local base = self.weapon
		local bonus = progression.level_bonus(level)
		self.weapon = setmetatable({
			blast_radius = base.blast_radius * bonus.radius,
			max_damage = math.floor(base.max_damage * bonus.damage + 0.5),
		}, { __index = base })
	end
	self.pos = go.get_position()
	self.origin_x = self.pos.x
	self.origin_y = self.pos.y
	self.vel = vmath.vector3(self.vel_x, self.vel_y, 0)
	self.fuse_timer = self.weapon.fuse_time
	self.bounces = 0
	self.is_active = true
	self.age = 0
	self.fuse_sound_timer = 0
	self.rot_angle = math.atan2(self.vel.y, self.vel.x) - math.rad(self.weapon.art_angle or 0)

	-- Homing missiles lock on the potato chosen by weapon_fire
	if self.target_id ~= 0 then
		for _, p in ipairs(game_state.potatoes) do
			if p.id == self.target_id then
				self.target = p
				break
			end
		end
	end

	-- Set sprite according to weapon
	sprite.play_flipbook("#sprite", hash(self.weapon.projectile_sprite))

	-- Set scale (0.55 = half of the previous 1.10)
	local s = (self.weapon.projectile_scale or 1.0) * 0.55
	go.set("#sprite", "scale", vmath.vector3(s, s, 1.0))

	-- Set tint
	local t = self.weapon.projectile_tint
	if t then
		go.set("#sprite", "tint", vmath.vector4(t[1], t[2], t[3], t[4]))
	end

	-- Projectile smoke & spark trail initialization (expanded and juicier)
	self.trail_timer = 0
	pcall(function()
		go.set("#trail1", "tint", vmath.vector4(1.0, 0.95, 0.7, 0.0))
		go.set("#trail2", "tint", vmath.vector4(1.6, 0.95, 0.3, 0.0))
		go.set("#trail3", "tint", vmath.vector4(0.9, 0.9, 0.9, 0.0))
		go.set("#trail4", "tint", vmath.vector4(2.0, 0.6, 0.2, 0.0))
		go.set("#trail5", "tint", vmath.vector4(2.0, 0.8, 0.25, 0.0))
		go.set("#trail6", "tint", vmath.vector4(0.7, 0.7, 0.7, 0.0))
		go.set("#trail1", "scale", vmath.vector3(1.0, 1.0, 1.0))
		go.set("#trail2", "scale", vmath.vector3(0.8, 0.8, 1.0))
		go.set("#trail3", "scale", vmath.vector3(1.2, 1.2, 1.0))
		go.set("#trail4", "scale", vmath.vector3(0.9, 0.9, 1.0))
		go.set("#trail5", "scale", vmath.vector3(0.9, 0.9, 1.0))
		go.set("#trail6", "scale", vmath.vector3(1.4, 1.4, 1.0))
	end)
end

local function apply_potato_damage(self, p, dmg, hit_x, hit_y)
	if dmg > 0 and p.url then
		local was_full_hp = (p.hp >= (p.max_hp or 100))
		local is_kill = (p.hp <= dmg)
		local dist = math.abs(p.pos.x - self.origin_x)

		msg.post(p.url, "apply_damage", { damage = dmg })
		msg.post("/gui_hud#gui", "show_damage", { x = p.pos.x, y = p.pos.y, amount = dmg })

		-- Credit the shooter for battle XP (hits on the own team do not count)
		local owner = self.owner
		if owner and owner.stats and owner.team ~= p.team then
			owner.stats.damage = owner.stats.damage + dmg
			if p.hp <= 0 then
				owner.stats.kills = owner.stats.kills + 1
			end
		end
		msg.post("/main#main", "potato_damaged", { x = p.pos.x, y = p.pos.y, damage = dmg, potato_id = p.id })

		if self.weapon.status_effect and p.is_alive then
			msg.post(p.url, "apply_status", {
				status = self.weapon.status_effect.type,
				duration = self.weapon.status_effect.duration,
				power = self.weapon.status_effect.power,
			})
			if p.statuses then
				p.statuses[self.weapon.status_effect.type] = {
					duration = self.weapon.status_effect.duration,
					power = self.weapon.status_effect.power,
				}
			end
		end

		if p.team == constants.TEAM_RED and game_state.active_team == constants.TEAM_BLUE then
			local triggered = achievements.on_player_hit_enemy(dist, was_full_hp, dmg, is_kill)
			for _, ach in ipairs(triggered) do
				msg.post("/gui_hud#gui", "show_achievement_toast", {
					icon = ach.icon,
					title = ach.title,
					points = ach.points
				})
			end
		elseif p.team == constants.TEAM_BLUE then
			achievements.on_player_damaged(dmg)
		end
	end
end

local function detonate(self, hit_x, hit_y, direct_hit_potato)
	constants.log(">>> PROJECTILE DETONATING AT:", hit_x, hit_y, "weapon:", self.weapon.id, "direct_hit:", direct_hit_potato and direct_hit_potato.id)
	self.is_active = false

	if self.weapon.on_hit == "napalm" or self.weapon.on_hit == "pepper" then
		local is_pepper = (self.weapon.on_hit == "pepper")
		-- Initial explosion and crater
		local crater_r = self.weapon.crater_radius or self.weapon.blast_radius
		msg.post("/terrain#terrain", "carve_crater", { x = hit_x, y = hit_y, radius = crater_r })
		msg.post("/main#main", "spawn_explosion", { x = hit_x, y = hit_y, radius = self.weapon.blast_radius })
		camera_controller.shake(self.weapon.blast_radius * 0.25, 0.2)
		
		-- Apply direct hit or blast damage
		for _, p in ipairs(game_state.potatoes) do
			if p.is_alive then
				local dmg = 0
				if direct_hit_potato and p.id == direct_hit_potato.id then
					dmg = self.weapon.max_damage
					p.hp = math.max(0, p.hp - dmg)
					if p.hp <= 0 then p.is_alive = false end
					p.vel.y = p.vel.y + (self.weapon.blast_force or 100) * 0.4
					p.is_grounded = false
				else
					dmg = physics_sim.apply_blast(p, hit_x, hit_y, self.weapon.blast_radius, self.weapon.blast_force, self.weapon.max_damage)
				end
				apply_potato_damage(self, p, dmg, hit_x, hit_y)
			end
		end
		
		-- Spawn napalm / pepper cloud patches
		msg.post("/main#main", "spawn_napalm", {
			x = hit_x,
			y = hit_y,
			count = is_pepper and (self.weapon.pepper_count or 6) or (self.weapon.napalm_count or 6),
			spread = is_pepper and (self.weapon.pepper_spread or 42) or (self.weapon.napalm_spread or 40),
			burn_time = is_pepper and (self.weapon.pepper_burn_time or 3.0) or (self.weapon.napalm_burn_time or 2.5),
			radius = is_pepper and (self.weapon.pepper_radius or 11) or (self.weapon.napalm_radius or 8),
			dps = is_pepper and (self.weapon.pepper_dps or 12) or (self.weapon.napalm_dps or 10),
			is_pepper = is_pepper,
		})

	elseif self.weapon.on_hit == "beetles" then
		-- Jar cracks open: small crater, visual explosion, and release 3 beetles!
		msg.post("/terrain#terrain", "carve_crater", { x = hit_x, y = hit_y, radius = 16 })
		msg.post("/main#main", "spawn_explosion", { x = hit_x, y = hit_y, radius = 20 })
		camera_controller.shake(5, 0.2)

		-- Spawn 3 beetle minions scattering in arcs
		msg.post("/main#main", "spawn_beetles", {
			x = hit_x,
			y = hit_y,
			count = self.weapon.beetle_count or 3,
			owner_id = self.owner_id
		})

	else
		-- Standard explosion (Rifle, Grenade, Bazooka, Shotgun, Burst, Holy Grenade, Drill, Garlic)
		local crater_r = self.weapon.crater_radius or self.weapon.blast_radius
		msg.post("/terrain#terrain", "carve_crater", {
			x = hit_x,
			y = hit_y,
			radius = crater_r
		})

		-- Spawn visual explosion
		msg.post("/main#main", "spawn_explosion", {
			x = hit_x,
			y = hit_y,
			radius = self.weapon.blast_radius,
			sfx = self.weapon.explode_sfx
		})

		-- Screen shake proportional to weapon blast
		camera_controller.shake(self.weapon.blast_radius * 0.35, 0.35)

		-- Apply damage and impulse to all living potatoes
		for _, p in ipairs(game_state.potatoes) do
			if p.is_alive then
				local dmg = 0
				local max_dmg = self.weapon.max_damage
				-- Tutorial fail-safe: the player cannot hurt themselves on the training ground
				local is_invulnerable = (game_state.mode == constants.MODE_TUTORIAL and p.team == constants.TEAM_BLUE)

				if is_invulnerable then
					local hp_before = p.hp
					physics_sim.apply_blast(p, hit_x, hit_y, self.weapon.blast_radius, self.weapon.blast_force, max_dmg)
					p.hp = hp_before
					p.is_alive = true
				elseif direct_hit_potato and p.id == direct_hit_potato.id then
					dmg = max_dmg
					p.hp = math.max(0, p.hp - dmg)
					if p.hp <= 0 then p.is_alive = false end
					local dir_x = (self.vel.x >= 0) and 1 or -1
					p.vel.x = p.vel.x + dir_x * (self.weapon.blast_force or 150) * 0.5
					p.vel.y = p.vel.y + (self.weapon.blast_force or 150) * 0.4
					p.is_grounded = false
				else
					dmg = physics_sim.apply_blast(p, hit_x, hit_y, self.weapon.blast_radius, self.weapon.blast_force, max_dmg)
				end
				apply_potato_damage(self, p, dmg, hit_x, hit_y)
			end
		end
	end

	-- Cluster bombs scatter their bomblets
	local cl = self.weapon.cluster
	if cl then
		msg.post("/main#main", "spawn_cluster", { x = hit_x, y = hit_y, count = cl.count, weapon_id = cl.weapon, owner_id = self.owner_id })
	end

	go.delete()
end

function update(self, dt)
	if not self.is_active then
		return
	end

	-- Lit fuse: hissing and a red blink before the blast
	if self.weapon.fuse_fx then
		self.fuse_sound_timer = self.fuse_sound_timer - dt
		if self.fuse_sound_timer <= 0 then
			self.fuse_sound_timer = FUSE_SOUND_EVERY
			sound_manager.play("fuse", { vary = 0.1 })
		end
	end
	if (self.weapon.bounciness or 0) > 0.1 and self.fuse_timer < BLINK_LAST then
		local on = math.floor(self.fuse_timer * 10) % 2 == 0
		go.set("#sprite", "tint", on and vmath.vector4(1, 0.45, 0.45, 1) or vmath.vector4(1, 1, 1, 1))
	end

	local status, hx, hy, hit_potato = physics_sim.update_projectile(self, dt, terrain_grid, game_state.potatoes, game_state.wind_vector)

	-- Update camera tracking to follow this projectile
	camera_controller.follow(self.pos.x, self.pos.y)

	if status == "bounce" then
		sound_manager.play("bounce", { vary = 0.15 })
	end

	if status == "explode" then
		detonate(self, hx, hy, hit_potato)
	elseif status == "water" then
		self.is_active = false
		sound_manager.play((game_state.current_biome == "volcano") and "sizzle" or "splash", { vary = 0.1 })
		camera_controller.shake(6, 0.25)
		msg.post("/main#main", "spawn_explosion", {
			x = self.pos.x,
			y = constants.WATER_LEVEL + 4,
			radius = 18,
			silent = true
		})
		msg.post("/gui_hud#gui", "show_damage", {
			x = self.pos.x,
			y = constants.WATER_LEVEL + 16,
			amount = 0,
			label = i18n.pick({ ru = "💦 БУЛЬК!", en = "💦 BLOOP!", pt = "💦 PLOFT!", fr = "💦 BLOUP !", es = "💦 ¡PLOF!", tr = "💦 BLUP!" })
		})
		go.delete()
	else
		-- Update game object transform
		go.set_position(self.pos)
		local speed = math.sqrt(self.vel.x * self.vel.x + self.vel.y * self.vel.y)
		if self.weapon.spin then
			if not self.is_resting then
				self.rot_angle = (self.rot_angle or 0) - self.vel.x * dt * 0.05
			end
		elseif speed > 10.0 then
			self.rot_angle = math.atan2(self.vel.y, self.vel.x) - math.rad(self.weapon.art_angle or 0)
		end
		go.set_rotation(vmath.quat_rotation_z(self.rot_angle or 0))

		-- Animate juicy trailing smoke/spark particles behind projectile (enhanced effects)
		self.trail_timer = (self.trail_timer or 0) + dt * 16.0
		pcall(function()
			local t1_a = math.min(0.90, (speed / 100.0)) * (0.7 + 0.3 * math.sin(self.trail_timer))
			local t2_a = math.min(1.0, (speed / 80.0)) * (0.7 + 0.3 * math.sin(self.trail_timer + 2.0))
			local t3_a = math.min(0.85, (speed / 120.0)) * (0.6 + 0.4 * math.sin(self.trail_timer + 4.0))
			local t4_a = math.min(1.0, (speed / 90.0)) * (0.7 + 0.3 * math.cos(self.trail_timer * 1.3))
			local t5_a = math.min(1.0, (speed / 90.0)) * (0.7 + 0.3 * math.sin(self.trail_timer * 1.3))
			local t6_a = math.min(0.75, (speed / 140.0)) * (0.5 + 0.5 * math.sin(self.trail_timer + 1.5))

			go.set("#trail1", "tint.w", t1_a)
			go.set("#trail2", "tint.w", t2_a)
			go.set("#trail3", "tint.w", t3_a)
			go.set("#trail4", "tint.w", t4_a)
			go.set("#trail5", "tint.w", t5_a)
			go.set("#trail6", "tint.w", t6_a)

			local s1 = 0.9 + 0.4 * math.sin(self.trail_timer)
			local s2 = 0.7 + 0.35 * math.cos(self.trail_timer * 1.5)
			local s3 = 1.2 + 0.5 * math.sin(self.trail_timer * 0.8)
			local s4 = 0.8 + 0.3 * math.sin(self.trail_timer * 1.4)
			local s5 = 0.8 + 0.3 * math.cos(self.trail_timer * 1.4)
			local s6 = 1.4 + 0.6 * math.sin(self.trail_timer * 0.6)

			go.set("#trail1", "scale", vmath.vector3(s1, s1, 1.0))
			go.set("#trail2", "scale", vmath.vector3(s2, s2, 1.0))
			go.set("#trail3", "scale", vmath.vector3(s3, s3, 1.0))
			go.set("#trail4", "scale", vmath.vector3(s4, s4, 1.0))
			go.set("#trail5", "scale", vmath.vector3(s5, s5, 1.0))
			go.set("#trail6", "scale", vmath.vector3(s6, s6, 1.0))
		end)
	end
end
