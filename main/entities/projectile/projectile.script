-- main/entities/projectile/projectile.script
-- Simulates projectile flight, bounce, detonation, and damage application

local constants = require("lua_modules.constants")
local weapons = require("lua_modules.weapons")
local physics_sim = require("lua_modules.physics_sim")
local terrain_grid = require("lua_modules.terrain_grid")
local camera_controller = require("lua_modules.camera_controller")
local game_state = require("lua_modules.game_state")
local achievements = require("lua_modules.achievements")

go.property("vel_x", 0)
go.property("vel_y", 0)
go.property("weapon_type", hash("grenade"))
go.property("owner_id", 0)

function init(self)
	local WEAPON_HASHES = {}
	for _, w in ipairs(weapons.LIST) do
		WEAPON_HASHES[hash(w.id)] = w.id
	end

	local w_id = WEAPON_HASHES[self.weapon_type] or "grenade"

	self.weapon = weapons.get(w_id)
	self.pos = go.get_position()
	self.origin_x = self.pos.x
	self.origin_y = self.pos.y
	self.vel = vmath.vector3(self.vel_x, self.vel_y, 0)
	self.fuse_timer = self.weapon.fuse_time
	self.bounces = 0
	self.is_active = true

	-- Set sprite according to weapon
	sprite.play_flipbook("#sprite", hash(self.weapon.projectile_sprite))

	-- Set scale
	local s = self.weapon.projectile_scale or 1.0
	go.set("#sprite", "scale", vmath.vector3(s, s, 1.0))

	-- Set tint
	local t = self.weapon.projectile_tint
	if t then
		go.set("#sprite", "tint", vmath.vector4(t[1], t[2], t[3], t[4]))
	end
end

local function apply_potato_damage(self, p, dmg, hit_x, hit_y)
	if dmg > 0 and p.url then
		local was_full_hp = (p.hp >= (p.max_hp or 100))
		local is_kill = (p.hp <= dmg)
		local dist = math.abs(p.pos.x - self.origin_x)

		msg.post(p.url, "apply_damage", { damage = dmg })
		msg.post("/gui_hud#gui", "show_damage", { x = p.pos.x, y = p.pos.y, amount = dmg })

		if p.team == constants.TEAM_RED and game_state.active_team == constants.TEAM_BLUE then
			local triggered = achievements.on_player_hit_enemy(dist, was_full_hp, dmg, is_kill)
			for _, ach in ipairs(triggered) do
				msg.post("/gui_hud#gui", "show_achievement_toast", {
					icon = ach.icon,
					title = ach.title,
					points = ach.points
				})
			end
		elseif p.team == constants.TEAM_BLUE then
			achievements.on_player_damaged(dmg)
		end
	end
end

local function detonate(self, hit_x, hit_y, direct_hit_potato)
	constants.log(">>> PROJECTILE DETONATING AT:", hit_x, hit_y, "weapon:", self.weapon.id, "direct_hit:", direct_hit_potato and direct_hit_potato.id)
	self.is_active = false

	if self.weapon.on_hit == "napalm" then
		-- Small initial explosion
		msg.post("/terrain#terrain", "carve_crater", { x = hit_x, y = hit_y, radius = self.weapon.blast_radius })
		msg.post("/main#main", "spawn_explosion", { x = hit_x, y = hit_y, radius = self.weapon.blast_radius })
		camera_controller.shake(self.weapon.blast_radius * 0.2, 0.2)
		
		-- Apply direct hit or blast damage
		for _, p in ipairs(game_state.potatoes) do
			if p.is_alive then
				local dmg = 0
				if direct_hit_potato and p.id == direct_hit_potato.id then
					dmg = self.weapon.max_damage
					p.hp = math.max(0, p.hp - dmg)
					if p.hp <= 0 then p.is_alive = false end
					p.vel.y = p.vel.y + (self.weapon.blast_force or 100) * 0.4
					p.is_grounded = false
				else
					dmg = physics_sim.apply_blast(p, hit_x, hit_y, self.weapon.blast_radius, self.weapon.blast_force, self.weapon.max_damage)
				end
				apply_potato_damage(self, p, dmg, hit_x, hit_y)
			end
		end
		
		-- Spawn napalm fire patches
		msg.post("/main#main", "spawn_napalm", {
			x = hit_x,
			y = hit_y,
			count = self.weapon.napalm_count or 6,
			spread = self.weapon.napalm_spread or 40,
			burn_time = self.weapon.napalm_burn_time or 2.5,
			radius = self.weapon.napalm_radius or 8,
			dps = self.weapon.napalm_dps or 10,
		})
	else
		-- Standard explosion (Rifle, Grenade, Bazooka, Shotgun, Burst, Holy Grenade)
		-- Carve crater in terrain
		msg.post("/terrain#terrain", "carve_crater", {
			x = hit_x,
			y = hit_y,
			radius = self.weapon.blast_radius
		})

		-- Spawn visual explosion
		msg.post("/main#main", "spawn_explosion", {
			x = hit_x,
			y = hit_y,
			radius = self.weapon.blast_radius
		})

		-- Screen shake proportional to weapon blast
		camera_controller.shake(self.weapon.blast_radius * 0.35, 0.35)

		-- Apply damage and impulse to all living potatoes
		for _, p in ipairs(game_state.potatoes) do
			if p.is_alive then
				local dmg = 0
				if direct_hit_potato and p.id == direct_hit_potato.id then
					dmg = self.weapon.max_damage
					p.hp = math.max(0, p.hp - dmg)
					if p.hp <= 0 then p.is_alive = false end
					local dir_x = (self.vel.x >= 0) and 1 or -1
					p.vel.x = p.vel.x + dir_x * (self.weapon.blast_force or 150) * 0.5
					p.vel.y = p.vel.y + (self.weapon.blast_force or 150) * 0.4
					p.is_grounded = false
				else
					dmg = physics_sim.apply_blast(p, hit_x, hit_y, self.weapon.blast_radius, self.weapon.blast_force, self.weapon.max_damage)
				end
				apply_potato_damage(self, p, dmg, hit_x, hit_y)
			end
		end

		if self.weapon.id == "grenade" and game_state.has_perk("fire_bullets") then
			msg.post("/main#main", "spawn_napalm", {
				x = hit_x,
				y = hit_y,
				count = 4,
				spread = 32,
				burn_time = 2.0,
				radius = 8,
				dps = 8,
			})
		end
	end

	go.delete()
end

function update(self, dt)
	if not self.is_active then
		return
	end

	local status, hx, hy, hit_potato = physics_sim.update_projectile(self, dt, terrain_grid, game_state.potatoes)

	-- Update camera tracking to follow this projectile
	camera_controller.follow(self.pos.x, self.pos.y)

	if status == "explode" then
		detonate(self, hx, hy, hit_potato)
	elseif status == "water" then
		self.is_active = false
		camera_controller.shake(4, 0.2)
		go.delete()
	else
		-- Update game object transform
		go.set_position(self.pos)
		local speed = math.sqrt(self.vel.x * self.vel.x + self.vel.y * self.vel.y)
		if speed > 10.0 then
			self.rot_angle = math.atan2(self.vel.y, self.vel.x)
		end
		go.set_rotation(vmath.quat_rotation_z(self.rot_angle or 0))
	end
end
