-- main/main.script
-- Central game orchestrator for Potato War: match lifecycle, message routing and the per-frame loop.
-- Gameplay pieces live in lua_modules: match_spawner, player_control, potato_updater,
-- weapon_fire, bot_turn, battle_camera, world_events, match_results, tutorial.

local constants = require("lua_modules.constants")
local terrain_grid = require("lua_modules.terrain_grid")
local game_state = require("lua_modules.game_state")
local camera_controller = require("lua_modules.camera_controller")
local player_profile = require("lua_modules.player_profile")
local sound_manager = require("lua_modules.sound_manager")
local achievements = require("lua_modules.achievements")
local level_config = require("lua_modules.level_config")
local strategic_campaign = require("lua_modules.strategic_campaign")
local tutorial = require("lua_modules.tutorial")
local match_spawner = require("lua_modules.match_spawner")
local player_control = require("lua_modules.player_control")
local potato_updater = require("lua_modules.potato_updater")
local weapon_fire = require("lua_modules.weapon_fire")
local bot_turn = require("lua_modules.bot_turn")
local battle_camera = require("lua_modules.battle_camera")
local world_events = require("lua_modules.world_events")
local match_results = require("lua_modules.match_results")

-- Control Mode Flag: "auto" (Mobile=slingshot, PC=direct), "direct", or "slingshot"
go.property("aim_control_mode", hash("auto")) -- options: hash("auto"), hash("direct"), or hash("slingshot")

local SEAMLESS_BATTLE_2 = {
	opponent_type = "bot",
	potato_count = 2,
	blue_count = 2,
	red_count = 2,
	terrain_type = "floating_islands",
	terrain_preset = "floating_islands",
	biome = "desert",
	is_seamless_battle = true,
	seamless_stage = 2,
	hat_blue = "hat_cap",
	blue_classes = { "assault", "sniper" },
	red_hats = { "hat_viking", "hat_beret" },
	red_classes = { "medic", "tank" },
	enemy_skill = "normal",
	bot_difficulty = "normal",
}

local function resolve_aim_control_mode(self)
	local cfg_mode = "auto"
	if self.aim_control_mode == hash("slingshot") then
		cfg_mode = "slingshot"
	elseif self.aim_control_mode == hash("direct") then
		cfg_mode = "direct"
	end
	local is_mobile = match_spawner.is_mobile_platform()
	local effective_mode = cfg_mode
	if effective_mode == "auto" then
		effective_mode = is_mobile and "slingshot" or "direct"
	end
	constants.log(">>> AIM CONTROL MODE:", effective_mode, "(configured:", cfg_mode, "mobile:", is_mobile, ")")
	return effective_mode
end

local function show_screen(gui_name)
	for _, name in ipairs({ "/gui_menu", "/gui_campaign_map", "/gui_game_over", "/gui_hud" }) do
		msg.post(name, (name == gui_name) and "enable" or "disable")
	end
end

local function start_game_match(self, mode, level, lobby_config)
	match_spawner.clear(self)
	battle_camera.cancel_victory(self)
	achievements.reset_match()
	tutorial.reset()

	if lobby_config then
		game_state.start_battle(lobby_config)
	else
		game_state.start_match(mode, level)
	end

	local is_tutorial = (game_state.mode == constants.MODE_TUTORIAL)
	local is_campaign = (game_state.mode == constants.MODE_CAMPAIGN)
	local config = game_state.get_current_config()
	local terrain_preset = config.terrain_type or config.terrain_preset or "hills"
	local biome = config.biome or level_config.deduce_biome(terrain_preset)
	if is_tutorial then
		terrain_preset = "flat"
		biome = "grass"
	end
	self.current_terrain_preset = terrain_preset

	-- The campaign battle type only applies to an active sector battle: resolve_battle clears the
	-- sector id but keeps the type, so a stale "defense" would add fortifications to other matches
	local in_sector_battle = strategic_campaign and strategic_campaign.active_battle_sector_id ~= nil
	local is_defense = not is_tutorial and ((config and config.battle_type == "defense")
		or (lobby_config and lobby_config.battle_type == "defense")
		or (in_sector_battle and strategic_campaign.active_battle_type == "defense"))

	local active_level = (lobby_config and (lobby_config.sector_id or lobby_config.level))
		or (config and (config.sector_id or config.level))
		or level
		or game_state.campaign_level
		or 1

	-- Generate terrain grid synchronously first so spawning uses the new level's terrain
	local grid_w = is_campaign and constants.TERRAIN_WIDTH or constants.PVP_TERRAIN_WIDTH
	terrain_grid.init(grid_w, constants.TERRAIN_HEIGHT, constants.TERRAIN_SCALE)
	terrain_grid.generate(terrain_preset, active_level, is_defense)
	msg.post("/terrain#terrain", "generate_terrain", {
		preset = terrain_preset,
		biome = biome,
		mode = mode,
		already_generated = true
	})

	if is_tutorial then
		match_spawner.spawn_tutorial(self)
	else
		match_spawner.spawn_battle(self, {
			config = config,
			lobby_config = lobby_config,
			is_campaign = is_campaign,
			is_defense = is_defense,
			active_level = active_level,
			terrain_preset = terrain_preset,
		})
	end

	-- Point active_potato to first blue potato so weapon selection equips the new instance
	game_state.active_potato = game_state.potatoes[1]
	if is_tutorial then
		game_state.select_weapon("bazooka")
	end

	battle_camera.start_flyover(self)

	show_screen("/gui_hud")
	msg.post("/gui_hud#gui", "match_started")
end

local function leave_match(self)
	game_state.poki_gameplay_stop()
	battle_camera.cancel_victory(self)
	match_spawner.clear(self)
	player_control.reset(self)
	tutorial.reset()
	camera_controller.reset(480, 270)
	msg.post("/aim_guide#aim_guide", "hide_aim")
	msg.post("/terrain#terrain", "set_menu_mode", { is_menu = true })
	game_state.set_state(constants.STATE_MENU)
end

local function on_turn_changed(self, active_team, active_potato)
	player_control.reset(self)
	achievements.on_turn_start(active_team)
	tutorial.on_turn_start()
	for _, p in ipairs(game_state.potatoes) do
		if p.is_alive and p.url then
			local is_act = (p == active_potato)
			msg.post(p.url, "set_active", { active = is_act })
			if is_act then
				msg.post(p.url, "set_weapon", { weapon_id = game_state.selected_weapon_id })
				msg.post(p.url, "set_facing", { facing = p.facing or 1 })
			end
		end
	end
end

local function on_game_over(self, winner_team, points_earned, hp_healed, current_hp, next_hp)
	msg.post("/aim_guide#aim_guide", "hide_aim")
	local data = match_results.build(self.seamless_stage, winner_team, points_earned, hp_healed, current_hp, next_hp)

	if winner_team == constants.TEAM_BLUE then
		-- Victory celebration: camera zoom on the winner & background fireworks salute
		battle_camera.start_victory(self, data)
		msg.post("/terrain#terrain", "victory_salute")
		sound_manager.play_heal()
	else
		battle_camera.cancel_victory(self)
		msg.post("/gui_game_over", "enable")
		msg.post("/gui_game_over#gui", "show_result", data)
	end
end

local function revive_player(self)
	local pot = nil
	for _, p in ipairs(game_state.potatoes) do
		if p.team == constants.TEAM_BLUE then
			pot = p
			break
		end
	end
	if not pot then
		return
	end

	local new_url = match_spawner.revive_potato(self, pot, 50)
	if game_state.mode == constants.MODE_CAMPAIGN then
		player_profile.set_campaign_hp(50)
	end

	game_state.winner_team = nil
	game_state.active_potato = pot
	game_state.active_team = constants.TEAM_BLUE
	game_state.turn_timer = constants.TURN_DURATION
	game_state.set_state(constants.STATE_TURN_ACTIVE)
	if game_state.on_turn_changed then
		game_state.on_turn_changed(constants.TEAM_BLUE, pot)
	end
	msg.post(new_url, "set_active", { active = true })

	camera_controller.follow(pot.pos.x, pot.pos.y, true)
	camera_controller.shake(8, 0.3)
	sound_manager.play_heal()

	msg.post("/gui_game_over", "disable")
	msg.post("/gui_hud", "enable")
	msg.post("/gui_hud#gui", "match_started")
	msg.post("/gui_hud#gui", "show_damage", { x = pot.pos.x, y = pot.pos.y, amount = 50, is_heal = true })
	game_state.poki_gameplay_start()
end

function init(self)
	constants.log(">>> MAIN SCRIPT INIT STARTED")
	msg.post(".", "acquire_input_focus")
	game_state.aim_control_mode = resolve_aim_control_mode(self)

	self.spawned_potatoes = {}
	self.spawned_barrels = {}
	self.spawned_crates = {}
	self.crate_timer = 35.0
	self.current_terrain_preset = "hills"
	self.airship_timer = 40.0
	self.airship_url = nil
	self.active_projectiles = {}
	self.burst_queue = {} -- { weapon_id, origin_x, origin_y, vel_x, vel_y, owner_id, shots_left, delay_timer }
	self.seamless_stage = 0
	player_control.reset(self)
	bot_turn.reset(self)
	battle_camera.init(self)

	-- Delay settling until damage zoom-in camera focus finishes (1.5 seconds)
	game_state.can_settle = function()
		return battle_camera.is_settled(self)
	end
	game_state.on_turn_changed = function(active_team, active_potato)
		on_turn_changed(self, active_team, active_potato)
	end
	game_state.on_cards_offered = function(card1, card2)
		msg.post("/gui_hud#gui", "show_cards", { card1 = card1, card2 = card2 })
	end
	game_state.on_weapon_changed = function(weapon_id)
		local target = game_state.active_potato
		if target and target.is_alive and target.url then
			msg.post(target.url, "set_weapon", { weapon_id = weapon_id })
		end
	end
	game_state.on_game_over = function(...)
		on_game_over(self, ...)
	end

	-- Launch sequence: Auto-start tutorial on first start, otherwise show main menu
	match_spawner.clear(self)
	camera_controller.reset(480, 270)
	if not player_profile.is_tutorial_completed() then
		if player_profile.get_onboarding_stage() == 1 then
			constants.log(">>> RESUMING SEAMLESS EXPERIENCE: BATTLE 2")
			msg.post(".", "start_seamless_battle_2")
		else
			self.seamless_stage = 1
			constants.log(">>> FIRST START: AUTO-LAUNCHING TUTORIAL SANDBOX")
			-- Deferred: terrain.script init generates its default "hills" grid after this init,
			-- starting right here would let it overwrite the flat training ground
			msg.post(".", "start_match", { mode = constants.MODE_TUTORIAL, level = 1 })
		end
	else
		show_screen("/gui_menu")
		msg.post("/terrain#terrain", "set_menu_mode", { is_menu = true })
	end
end

function update(self, dt)
	world_events.update(self, dt)
	camera_controller.update(dt)
	player_control.update(self, dt)
	potato_updater.update(dt)
	tutorial.update(dt, game_state.potatoes)
	weapon_fire.track_projectiles(self)
	weapon_fire.update_bursts(self, dt)
	bot_turn.update(self, dt)
	battle_camera.update(self, dt)
	game_state.update(dt, #self.active_projectiles)
end

function on_input(self, action_id, action)
	-- Skip flyover on any press
	if action.pressed and battle_camera.skip_flyover(self) then
		game_state.skip_intro()
	end

	-- Trigger poki gameplay_start ONLY on player's first active gameplay input
	if action.pressed and player_control.is_player_turn() then
		game_state.poki_gameplay_start()
	end

	if player_control.on_input(self, action_id, action) then
		return true
	end

	if (action_id == hash("inventory") or action_id == hash("key_q")) and action.pressed then
		if game_state.mode ~= constants.MODE_CAMPAIGN then
			msg.post("/gui_hud#gui", "toggle_inventory")
		end
		return true
	end

	if action_id == hash("escape") and action.pressed then
		msg.post(".", "show_menu")
		return true
	end

	return false
end

local function remove_by_url(list, target)
	if not target then
		return
	end
	local target_path = msg.url(target).path
	for i = #list, 1, -1 do
		local item = list[i]
		if item.url == target or item.id == target or msg.url(item.url).path == target_path then
			table.remove(list, i)
		end
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("start_battle") then
		start_game_match(self, nil, 1, message)

	elseif message_id == hash("start_seamless_battle_2") then
		self.seamless_stage = 2
		start_game_match(self, constants.MODE_QUICK_BOT, 1, SEAMLESS_BATTLE_2)

	elseif message_id == hash("start_match") then
		start_game_match(self, message.mode, message.level)

	elseif message_id == hash("select_card") then
		game_state.select_card(message.card_index)

	elseif message_id == hash("show_menu") then
		leave_match(self)
		show_screen("/gui_menu")

	elseif message_id == hash("show_campaign_map") then
		leave_match(self)
		show_screen("/gui_campaign_map")
		msg.post("/gui_campaign_map#gui", "show")

	elseif message_id == hash("player_move_state") or message_id == hash("player_move") then
		player_control.set_touch_dir(self, message.dir)

	elseif message_id == hash("player_jump") then
		if player_control.is_player_turn() then
			game_state.poki_gameplay_start()
		end
		player_control.jump()

	elseif message_id == hash("fire_weapon") then
		if game_state.mode == constants.MODE_TUTORIAL then
			tutorial.on_shot()
		end
		weapon_fire.fire(self, message)

	elseif message_id == hash("spawn_explosion") then
		sound_manager.play_explosion()
		factory.create("#explosion_factory", vmath.vector3(message.x, message.y, 0.5), nil, {
			radius = message.radius or 30
		})
		tutorial.on_impact(message.x)
		-- Check impact on barrels and crates
		local blast = { x = message.x, y = message.y, radius = message.radius or 30 }
		for _, b in ipairs(self.spawned_barrels or {}) do
			pcall(msg.post, b.url, "check_blast", blast)
		end
		for _, c in ipairs(self.spawned_crates or {}) do
			pcall(msg.post, c.url, "check_blast", blast)
		end

	elseif message_id == hash("spawn_napalm") then
		weapon_fire.spawn_napalm(self, message)

	elseif message_id == hash("spawn_beetles") then
		weapon_fire.spawn_beetles(self, message)

	elseif message_id == hash("potato_damaged") then
		if message.damage and message.damage > 0 and message.x and message.y then
			-- Worms-style damage camera: linger at hit point and zoom in slightly for 1.5s
			battle_camera.focus_damage(self, message.x, message.y, message.potato_id)
			for _, p in ipairs(game_state.potatoes) do
				if p.id == message.potato_id and p.team == constants.TEAM_RED then
					tutorial.on_enemy_hit()
					break
				end
			end
		end

	elseif message_id == hash("barrel_destroyed") or message_id == hash("barrel_detonated") then
		remove_by_url(self.spawned_barrels, message.id or message.barrel_url or message.barrel_id)

	elseif message_id == hash("crate_collected") or message_id == hash("crate_destroyed") then
		remove_by_url(self.spawned_crates, message.url)

	elseif message_id == hash("airship_drop_bomb") then
		weapon_fire.drop_air_bomb(self, message)

	elseif message_id == hash("airship_finished") then
		world_events.on_airship_finished(self)

	elseif message_id == hash("revive_player") then
		game_state.poki_rewarded_break(function(success)
			if success then
				revive_player(self)
			end
		end)
	end
end
