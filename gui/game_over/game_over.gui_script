-- gui/game_over/game_over.gui_script
-- Displays round victory with points & Next button, and defeat options

local constants = require("lua_modules.constants")
local game_state = require("lua_modules.game_state")
local ui_manager = require("lua_modules.ui_manager")
local i18n = require("lua_modules.i18n")

function init(self)
	msg.post(".", "acquire_input_focus")
	gui.set_render_order(10)
	self.ui = ui_manager.create(self)

	self.ui:button("btn_rematch", function()
		msg.post(".", "disable")
		msg.post("/main#main", "start_match", {
			mode = game_state.mode,
			level = (game_state.mode == constants.MODE_CAMPAIGN) and 1 or game_state.campaign_level
		})
	end)

	self.ui:button("btn_next_level", function()
		msg.post(".", "disable")
		local next_lvl = game_state.campaign_level + 1
		msg.post("/main#main", "start_match", {
			mode = constants.MODE_CAMPAIGN,
			level = next_lvl
		})
	end)

	self.ui:button("btn_menu", function()
		msg.post(".", "disable")
		msg.post("/main#main", "show_menu")
	end)

	-- Hidden by default
	msg.post(".", "disable")
end

function on_input(self, action_id, action)
	return self.ui:on_input(action_id, action)
end

function update(self, dt)
	self.ui:update(dt)
end

function on_message(self, message_id, message, sender)
	if message_id == hash("show_result") then
		msg.post(".", "enable")

		local winner = message.winner
		local points = message.points or 0

		local title_node = gui.get_node("title_text")
		local sub_node = gui.get_node("subtitle_text")
		local reward_bg = gui.get_node("reward_bg")
		local reward_txt = gui.get_node("reward_text")
		local rematch_btn = gui.get_node("btn_rematch")
		local rematch_txt = gui.get_node("txt_rematch")
		local next_btn = gui.get_node("btn_next_level")
		local next_txt = gui.get_node("txt_next_level")
		local menu_btn = gui.get_node("btn_menu")
		local menu_txt = gui.get_node("txt_menu")

		local is_ru = (i18n.current_lang == "ru")

		local achieve_node = gui.get_node("achieve_text")
		local ach_list = message.achievements or {}
		local ach_bonus = message.achieve_bonus or 0

		if winner == constants.TEAM_BLUE then
			-- VICTORY
			gui.set_text(title_node, i18n.t("victory"))
			gui.set_color(title_node, vmath.vector4(0.18, 0.80, 0.44, 1.0))
			gui.set_text(sub_node, is_ru and "Раунд выигран!" or "Round won!")

			local total_str = "+" .. tostring(points) .. (is_ru and " ОЧКОВ" or " POINTS")
			if ach_bonus > 0 then
				total_str = total_str .. (is_ru and (" (Бонус +" .. tostring(ach_bonus) .. ")") or (" (Bonus +" .. tostring(ach_bonus) .. ")"))
			end
			gui.set_text(reward_txt, total_str)

			if #ach_list > 0 then
				local badges_str = ""
				for idx, a in ipairs(ach_list) do
					local separator = (idx > 1) and " • " or ""
					badges_str = badges_str .. separator .. (a.icon or "🏆") .. " " .. (a.title or "") .. " (+" .. tostring(a.points) .. ")"
				end
				gui.set_text(achieve_node, badges_str)
				gui.set_enabled(achieve_node, true)
			else
				gui.set_text(achieve_node, is_ru and "Совет: Уничтожьте врага без урона или за 1 выстрел для бонуса!" or "Tip: Win with 0 damage or in 1 shot for bonus!")
				gui.set_enabled(achieve_node, true)
			end

			gui.set_text(next_txt, is_ru and "ДАЛЕЕ" or "NEXT")

			gui.set_enabled(reward_bg, true)
			gui.set_enabled(reward_txt, true)
			gui.set_enabled(next_btn, true)
			gui.set_enabled(next_txt, true)

			gui.set_enabled(rematch_btn, false)
			gui.set_enabled(rematch_txt, false)
			gui.set_enabled(menu_btn, false)
			gui.set_enabled(menu_txt, false)

		elseif winner == constants.TEAM_RED then
			-- DEFEAT
			gui.set_text(title_node, i18n.t("defeat"))
			gui.set_color(title_node, vmath.vector4(0.91, 0.30, 0.24, 1.0))
			gui.set_text(sub_node, is_ru and "Ваша картошка уничтожена." or "Your potato was destroyed.")
			gui.set_text(rematch_txt, is_ru and "НАЧАТЬ ЗАНОВО" or "RESTART")
			gui.set_text(menu_txt, i18n.t("btn_menu"))

			gui.set_enabled(reward_bg, false)
			gui.set_enabled(reward_txt, false)
			gui.set_enabled(achieve_node, false)
			gui.set_enabled(next_btn, false)
			gui.set_enabled(next_txt, false)

			gui.set_enabled(rematch_btn, true)
			gui.set_enabled(rematch_txt, true)
			gui.set_enabled(menu_btn, true)
			gui.set_enabled(menu_txt, true)
		else
			-- DRAW
			gui.set_text(title_node, i18n.t("draw"))
			gui.set_color(title_node, vmath.vector4(0.95, 0.77, 0.06, 1.0))
			gui.set_text(sub_node, i18n.t("sub_draw"))
			gui.set_text(rematch_txt, i18n.t("btn_rematch"))
			gui.set_text(menu_txt, i18n.t("btn_menu"))

			gui.set_enabled(reward_bg, false)
			gui.set_enabled(reward_txt, false)
			gui.set_enabled(achieve_node, false)
			gui.set_enabled(next_btn, false)
			gui.set_enabled(next_txt, false)

			gui.set_enabled(rematch_btn, true)
			gui.set_enabled(rematch_txt, true)
			gui.set_enabled(menu_btn, true)
			gui.set_enabled(menu_txt, true)
		end
	end
end

