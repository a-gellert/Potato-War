-- gui/game_over/game_over.gui_script
-- Military Debriefing & Combat Results Controller for Potato War

local constants = require("lua_modules.constants")
local game_state = require("lua_modules.game_state")
local ui_manager = require("lua_modules.ui_manager")
local player_profile = require("lua_modules.player_profile")
local i18n = require("lua_modules.i18n")
local strategic_campaign = require("lua_modules.strategic_campaign")
local territory_map = require("lua_modules.territory_map")
local sound_manager = require("lua_modules.sound_manager")

function init(self)
	msg.post(".", "acquire_input_focus")
	gui.set_render_order(10)
	self.ui = ui_manager.create(self)

	self.ui:button("btn_rematch", function()
		msg.post(".", "disable")
		msg.post("/main#main", "start_match", {
			mode = game_state.mode,
			level = game_state.campaign_level or 1
		})
	end)

	self.ui:button("btn_revive", function()
		msg.post(".", "disable")
		msg.post("/main#main", "revive_player")
	end)

	self.ui:button("btn_next_level", function()
		msg.post(".", "disable")
		msg.post("/main#main", "show_campaign_map")
	end)

	self.ui:button("btn_shop", function()
		msg.post(".", "disable")
		msg.post("/gui_menu#gui", "open_shop", { mode = "skins" })
	end)

	self.ui:button("btn_menu", function()
		msg.post(".", "disable")
		msg.post("/main#main", "show_menu")
	end)

	-- Hidden by default
	pcall(function()
		gui.set_enabled(gui.get_node("seamless_panel"), false)
		gui.set_enabled(gui.get_node("seamless_blackout"), false)
	end)
	msg.post(".", "disable")
end

function on_input(self, action_id, action)
	if self.seamless_active then
		return true
	end
	return self.ui:on_input(action_id, action)
end

function update(self, dt)
	self.ui:update(dt)
end

function on_message(self, message_id, message, sender)
	if message_id == hash("show_result") then
		msg.post(".", "enable")

		local winner = message.winner
		local points = message.points or 0
		local ach_list = message.achievements or {}
		local ach_bonus = message.achieve_bonus or 0
		local outcome = message.campaign_outcome or strategic_campaign.last_battle_outcome
		local is_campaign = (game_state.mode == constants.MODE_CAMPAIGN) or (outcome ~= nil)
		local is_ru = (i18n.current_lang == "ru")

		local seamless_panel = gui.get_node("seamless_panel")
		local seamless_blackout = gui.get_node("seamless_blackout")

		if message.seamless then
			self.seamless_active = true
			gui.set_enabled(seamless_panel, true)
			gui.set_enabled(seamless_blackout, false)
			gui.set_color(seamless_blackout, vmath.vector4(0, 0, 0, 0))

			-- Hide standard debrief UI and all action buttons
			local nodes_to_hide = {
				"debrief_banner", "reward_bg", "debrief_stats_bg",
				"skin_progress_bg", "minimap_bg", "header_badge",
				"btn_rematch", "btn_revive", "btn_next_level", "btn_shop", "btn_menu",
				"txt_rematch", "txt_revive", "txt_next_level", "txt_shop", "txt_menu"
			}
			for _, nid in ipairs(nodes_to_hide) do
				pcall(function() gui.set_enabled(gui.get_node(nid), false) end)
			end

			-- 1. Word Victory (Defeat) in LARGE letters
			local title_node = gui.get_node("seamless_title")
			local is_win = (winner == constants.TEAM_BLUE)
			if is_win then
				gui.set_text(title_node, i18n.t("victory"))
				gui.set_color(title_node, vmath.vector4(0.2, 0.95, 0.45, 1.0))
			else
				gui.set_text(title_node, i18n.t("defeat"))
				gui.set_color(title_node, vmath.vector4(0.95, 0.25, 0.25, 1.0))
			end

			-- Title punch-in animation with juicy bouncy overshoot
			gui.set_scale(title_node, vmath.vector3(0.2, 0.2, 1.0))
			gui.animate(title_node, "scale", vmath.vector3(1.5, 1.5, 1.0), gui.EASING_OUTBACK, 0.45)

			-- 2. Coins count
			local coins_amt = message.coins_awarded or message.points or 100
			local coins_node = gui.get_node("seamless_coins_text")
			gui.set_text(coins_node, string.format("🪙 +%d %s", coins_amt, i18n.t("points_lbl"):gsub("[:%s]+", ""):upper()))
			local coins_bg = gui.get_node("seamless_coins_bg")
			gui.set_scale(coins_bg, vmath.vector3(0.4, 0.4, 1.0))
			gui.animate(coins_bg, "scale", vmath.vector3(1.0, 1.0, 1.0), gui.EASING_OUTBACK, 0.4, 0.1)

			-- 3. Unlocked hat with juicy effects
			local hat_card = gui.get_node("seamless_hat_card")
			local hat_sprite = gui.get_node("seamless_hat_sprite")
			local hat_badge = gui.get_node("seamless_hat_badge")
			local hat_name = gui.get_node("seamless_hat_name")
			local hat_glow = gui.get_node("seamless_hat_glow")
			local star1 = gui.get_node("seamless_hat_star_1")
			local star2 = gui.get_node("seamless_hat_star_2")

			gui.set_text(hat_badge, i18n.t("achieve_bonus"))
			local default_cap = player_profile.SKINS[2]
			gui.set_text(hat_name, message.unlocked_hat_name or player_profile.get_skin_name(default_cap, i18n.current_lang))

			if message.unlocked_hat_sprite then
				gui.play_flipbook(hat_sprite, hash(message.unlocked_hat_sprite))
			end

			-- Hat card scale pop-in
			gui.set_scale(hat_card, vmath.vector3(0.1, 0.1, 1.0))
			gui.animate(hat_card, "scale", vmath.vector3(1.0, 1.0, 1.0), gui.EASING_OUTBACK, 0.5, 0.15)

			-- Hat sprite floating bounce
			gui.set_position(hat_sprite, vmath.vector3(0, 8, 0))
			gui.animate(hat_sprite, "position.y", 22, gui.EASING_INOUTQUAD, 0.65, 0.2, nil, gui.PLAYBACK_LOOP_PINGPONG)

			-- Pulsating glowing aura
			gui.set_scale(hat_glow, vmath.vector3(0.85, 0.85, 1.0))
			gui.animate(hat_glow, "scale", vmath.vector3(1.20, 1.20, 1.0), gui.EASING_INOUTQUAD, 0.75, 0, nil, gui.PLAYBACK_LOOP_PINGPONG)

			-- Twinkling stars
			gui.set_scale(star1, vmath.vector3(0.85, 0.85, 1.0))
			gui.animate(star1, "scale", vmath.vector3(1.25, 1.25, 1.0), gui.EASING_INOUTQUAD, 0.60, 0, nil, gui.PLAYBACK_LOOP_PINGPONG)
			gui.set_scale(star2, vmath.vector3(0.85, 0.85, 1.0))
			gui.animate(star2, "scale", vmath.vector3(1.25, 1.25, 1.0), gui.EASING_INOUTQUAD, 0.60, 0.15, nil, gui.PLAYBACK_LOOP_PINGPONG)

			-- Sound cues
			if is_win then
				sound_manager.play_victory_march()
			else
				sound_manager.play_defeat_accent()
			end
			sound_manager.play_heal()

			-- 4. Automatically fade out after 2 seconds:
			local stage = message.seamless_stage or 1
			timer.delay(2.0, false, function()
				gui.set_enabled(seamless_blackout, true)
				gui.set_color(seamless_blackout, vmath.vector4(0, 0, 0, 0))
				gui.animate(seamless_blackout, "color.w", 1.0, gui.EASING_INQUAD, 0.35, 0, function()
					self.seamless_active = false
					msg.post(".", "disable")
					if stage == 1 then
						msg.post("/main#main", "start_seamless_battle_2")
					else
						msg.post("/main#main", "show_menu")
					end
				end)
			end)
			return
		else
			-- Regular match debrief: ensure seamless panel is hidden
			gui.set_enabled(seamless_panel, false)
			gui.set_enabled(seamless_blackout, false)
		end

		local title_node = gui.get_node("title_text")
		local sub_node = gui.get_node("subtitle_text")
		local reward_bg = gui.get_node("reward_bg")
		local reward_txt = gui.get_node("reward_text")
		local achieve_node = gui.get_node("achieve_text")
		local stats_bg = gui.get_node("debrief_stats_bg")
		local stats_title = gui.get_node("txt_stats_title")
		local stats_detail = gui.get_node("txt_stats_detail")
		local stats_front = gui.get_node("txt_stats_front")
		local skin_bg = gui.get_node("skin_progress_bg")
		local skin_txt = gui.get_node("skin_progress_txt")
		local minimap_bg = gui.get_node("minimap_bg")
		local rematch_btn = gui.get_node("btn_rematch")
		local rematch_txt = gui.get_node("txt_rematch")
		local next_btn = gui.get_node("btn_next_level")
		local next_txt = gui.get_node("txt_next_level")
		local revive_btn = gui.get_node("btn_revive")
		local revive_txt = gui.get_node("txt_revive")
		local shop_btn = gui.get_node("btn_shop")
		local shop_txt = gui.get_node("txt_shop")
		local menu_btn = gui.get_node("btn_menu")
		local menu_txt = gui.get_node("txt_menu")
		local header_badge = gui.get_node("header_badge")

		gui.set_text(header_badge, i18n.t("debrief_title"))
		gui.set_text(shop_txt, i18n.t("btn_shop"))
		gui.set_text(menu_txt, i18n.t("btn_menu"))

		-- 1. Frontline Minimap & Layout Setup
		if is_campaign then
			gui.set_enabled(minimap_bg, true)
			gui.set_position(reward_bg, vmath.vector3(295, 338, 0))
			gui.set_position(stats_bg, vmath.vector3(295, 238, 0))
			gui.set_position(skin_bg, vmath.vector3(295, 166, 0))

			-- Update 18 sector indicators
			for sid = 1, 18 do
				local sec = territory_map.get_sector(sid)
				local dot_node = gui.get_node("m_sec_" .. sid)
				local is_blue = (sec and sec.owner == "blue")
				gui.set_color(dot_node, is_blue and vmath.vector4(0.20, 0.62, 0.98, 1.0) or vmath.vector4(0.92, 0.26, 0.24, 1.0))
			end

			-- Highlight contested sector
			local active_sid = outcome and outcome.sector_id
			local pulse_node = gui.get_node("m_sec_pulse")
			if active_sid and active_sid >= 1 and active_sid <= 18 then
				local m_dot = gui.get_node("m_sec_" .. active_sid)
				local dot_pos = gui.get_position(m_dot)
				gui.set_position(pulse_node, dot_pos)
				gui.set_enabled(pulse_node, true)
				gui.set_scale(pulse_node, vmath.vector3(0.7, 0.7, 1))
				gui.animate(pulse_node, "scale", vmath.vector3(2.2, 2.2, 1), gui.EASING_OUTQUAD, 0.85, 0, nil, gui.PLAYBACK_LOOP_PINGPONG)

				if outcome.is_victory and outcome.battle_type == "assault" then
					-- Start Red, then animated flip to Blue
					gui.set_color(m_dot, vmath.vector4(0.92, 0.26, 0.24, 1.0))
					gui.animate(m_dot, "scale", vmath.vector3(1.8, 1.8, 1), gui.EASING_OUTBACK, 0.55, 0.2, function()
						gui.set_color(m_dot, vmath.vector4(0.20, 0.62, 0.98, 1.0))
						gui.animate(m_dot, "scale", vmath.vector3(1.0, 1.0, 1), gui.EASING_INOUTQUAD, 0.25)
					end)
				elseif (not outcome.is_victory) and outcome.battle_type == "defense" then
					-- Start Blue, then animated flip to Red
					gui.set_color(m_dot, vmath.vector4(0.20, 0.62, 0.98, 1.0))
					gui.animate(m_dot, "scale", vmath.vector3(1.8, 1.8, 1), gui.EASING_OUTBACK, 0.55, 0.2, function()
						gui.set_color(m_dot, vmath.vector4(0.92, 0.26, 0.24, 1.0))
						gui.animate(m_dot, "scale", vmath.vector3(1.0, 1.0, 1), gui.EASING_INOUTQUAD, 0.25)
					end)
				else
					gui.animate(m_dot, "scale", vmath.vector3(1.4, 1.4, 1), gui.EASING_OUTQUAD, 0.35, 0, function()
						gui.animate(m_dot, "scale", vmath.vector3(1.0, 1.0, 1), gui.EASING_INQUAD, 0.2)
					end)
				end
			else
				gui.set_enabled(pulse_node, false)
			end

			-- Territory control counters
			local blue_secs = territory_map.get_sectors_by_owner("blue")
			local blue_cnt = #blue_secs
			local red_cnt = 18 - blue_cnt
			local pct = math.floor((blue_cnt / 18) * 100)
			gui.set_text(gui.get_node("minimap_legend"), string.format(is_ru and "🔵 СИНИЕ: %d    🔴 КРАСНЫЕ: %d" or "🔵 BLUE: %d    🔴 RED: %d", blue_cnt, red_cnt))
			gui.set_size(gui.get_node("minimap_bar_fill"), vmath.vector3(math.floor(250 * (blue_cnt / 18)), 8, 0))
			gui.set_text(gui.get_node("minimap_status_lbl"), string.format(i18n.t("frontline_control_fmt"), blue_cnt, pct))
		else
			gui.set_enabled(minimap_bg, false)
			gui.set_position(reward_bg, vmath.vector3(480, 338, 0))
			gui.set_position(stats_bg, vmath.vector3(480, 238, 0))
			gui.set_position(skin_bg, vmath.vector3(480, 166, 0))
		end

		-- 2. Sound Cues
		if winner == constants.TEAM_BLUE then
			if outcome and outcome.battle_type == "assault" then
				sound_manager.play_flag_captured()
				timer.delay(0.35, false, function() sound_manager.play_victory_march() end)
			else
				sound_manager.play_victory_march()
			end
		elseif winner == constants.TEAM_RED then
			if outcome and outcome.battle_type == "defense" then
				sound_manager.play_siren()
				timer.delay(0.40, false, function() sound_manager.play_defeat_accent() end)
			else
				sound_manager.play_defeat_accent()
			end
		end

		-- 3. Title, Subtitle & Outcome Description
		if winner == constants.TEAM_BLUE then
			gui.set_color(title_node, vmath.vector4(0.18, 0.82, 0.44, 1.0))
			if is_campaign and outcome then
				if outcome.campaign_won then
					gui.set_text(title_node, i18n.t("debrief_campaign_won"))
					gui.set_text(sub_node, i18n.t("debrief_sub_camp_won"))
				elseif outcome.battle_type == "assault" then
					local sname = (outcome.sector_id and territory_map.get_sector_name(outcome.sector_id, i18n.current_lang)) or outcome.sector_name_en or outcome.sector_name_ru or ""
					gui.set_text(title_node, string.format(i18n.t("debrief_sector_liberated"), sname:upper()))
					gui.set_text(sub_node, i18n.t("debrief_sub_liberated"))
				else
					local sname = (outcome.sector_id and territory_map.get_sector_name(outcome.sector_id, i18n.current_lang)) or outcome.sector_name_en or outcome.sector_name_ru or ""
					gui.set_text(title_node, string.format(i18n.t("debrief_attack_repelled"), sname:upper()))
					gui.set_text(sub_node, i18n.t("debrief_sub_repelled"))
				end
			else
				gui.set_text(title_node, i18n.t("victory"))
				gui.set_text(sub_node, i18n.t("sub_victory"))
			end
		elseif winner == constants.TEAM_RED then
			gui.set_color(title_node, vmath.vector4(0.92, 0.28, 0.24, 1.0))
			if is_campaign and outcome then
				if outcome.campaign_lost then
					gui.set_text(title_node, i18n.t("debrief_campaign_lost"))
					gui.set_text(sub_node, i18n.t("debrief_sub_camp_lost"))
				elseif outcome.battle_type == "defense" then
					local sname = (outcome.sector_id and territory_map.get_sector_name(outcome.sector_id, i18n.current_lang)) or outcome.sector_name_en or outcome.sector_name_ru or ""
					gui.set_text(title_node, string.format(i18n.t("debrief_sector_lost"), sname:upper()))
					gui.set_text(sub_node, i18n.t("debrief_sub_lost"))
				else
					gui.set_text(title_node, i18n.t("debrief_assault_failed"))
					gui.set_text(sub_node, i18n.t("debrief_sub_failed"))
				end
			else
				gui.set_text(title_node, i18n.t("defeat"))
				gui.set_text(sub_node, i18n.t("sub_defeat"))
			end
		else
			gui.set_color(title_node, vmath.vector4(0.95, 0.77, 0.06, 1.0))
			gui.set_text(title_node, i18n.t("draw"))
			gui.set_text(sub_node, i18n.t("sub_draw"))
		end

		-- 4. Debrief Stats Box
		gui.set_text(stats_title, i18n.t("debrief_combat_report"))
		if is_campaign and outcome then
			local sec = outcome.sector_id and territory_map.get_sector(outcome.sector_id)
			local def_lvl = sec and sec.defense_level or 1
			local stars = string.format("[%d/3]", def_lvl)
			local inc = sec and sec.income or 25
			local sname = (outcome.sector_id and territory_map.get_sector_name(outcome.sector_id, i18n.current_lang)) or i18n.t("hud_sector")
			if outcome.is_victory then
				gui.set_text(stats_detail, i18n.t("hud_sector") .. ": " .. sname)
				gui.set_text(stats_front, stars .. " • +" .. tostring(inc) .. " 🥔")
			else
				gui.set_text(stats_detail, i18n.t("hud_sector") .. ": " .. sname)
				gui.set_text(stats_front, stars)
			end
		else
			gui.set_text(stats_detail, i18n.t("debrief_combat_report"))
			gui.set_text(stats_front, "100%")
		end

		-- 5. Rewards and Achievements
		if winner == constants.TEAM_BLUE then
			local pts_word = i18n.t("points_lbl"):gsub("[:%s]+", ""):upper()
			local total_str = "+" .. tostring(points) .. " " .. pts_word
			local stars_earned = message.stars_earned or (outcome and outcome.stars_earned) or 0
			if stars_earned > 0 then
				total_str = total_str .. "  •  +" .. tostring(stars_earned) .. " ★"
			end
			if ach_bonus > 0 then
				total_str = total_str .. " (+" .. tostring(ach_bonus) .. ")"
			end
			gui.set_text(reward_txt, total_str)

			if #ach_list > 0 then
				local badges_str = ""
				for idx, a in ipairs(ach_list) do
					local separator = (idx > 1) and " • " or ""
					badges_str = badges_str .. separator .. (a.icon or "🏆") .. " " .. (a.title or "") .. " (+" .. tostring(a.points) .. ")"
				end
				gui.set_text(achieve_node, badges_str)
			else
				gui.set_text(achieve_node, is_ru and "Совет: Сохраните всех бойцов отряда для бонуса +1 звезда!" or "Tip: Keep all squad members alive for +1 star bonus!")
			end
			gui.set_enabled(reward_bg, true)
		else
			gui.set_text(reward_txt, "+0 " .. (is_ru and "ОЧКОВ" or "POINTS"))
			gui.set_text(achieve_node, is_ru and "Враг оказался сильнее. Перегруппируйтесь!" or "Enemy was stronger. Regroup your forces!")
			gui.set_enabled(reward_bg, true)
		end

		-- 6. Skin Progress
		pcall(function()
			local prog = player_profile.get_next_skin_progress()
			if prog and prog.skin then
				gui.set_enabled(skin_bg, true)
				local skin_name = player_profile.get_skin_name(prog.skin, i18n.current_lang)
				if prog.can_buy then
					local ready_msg = string.format("🎉 %s (%d) • %s", skin_name, prog.target_price, i18n.t("btn_shop"))
					gui.set_text(skin_txt, ready_msg)
					gui.set_color(skin_txt, vmath.vector4(0.3, 1.0, 0.5, 1.0))
				else
					local prog_msg = string.format("🪙 %d / %d → %s", prog.current_points, prog.target_price, skin_name)
					gui.set_text(skin_txt, prog_msg)
					gui.set_color(skin_txt, vmath.vector4(1.0, 0.85, 0.25, 1.0))
				end
			else
				gui.set_enabled(skin_bg, false)
			end
		end)

		-- 7. Action Buttons
		if message.is_tutorial or game_state.mode == constants.MODE_TUTORIAL then
			gui.set_color(title_node, vmath.vector4(0.2, 0.95, 0.45, 1.0))
			gui.set_text(title_node, is_ru and "ТЫ ГОТОВ К БОЮ!" or "YOU ARE READY!")
			gui.set_text(sub_node, is_ru and "Тренировка завершена на отлично. Враг повержен!" or "Training completed with honors. Target eliminated!")
			gui.set_text(next_txt, is_ru and "НАЧАТЬ КАМПАНИЮ ⚔️" or "START CAMPAIGN ⚔️")
			gui.set_enabled(next_btn, true)
			gui.set_enabled(next_txt, true)
			gui.set_position(next_btn, vmath.vector3(480, 95, 0))
			gui.set_enabled(revive_btn, false)
			gui.set_enabled(revive_txt, false)
			gui.set_enabled(rematch_btn, false)
			gui.set_enabled(rematch_txt, false)
			gui.set_enabled(minimap_bg, false)
		elseif is_campaign then
			gui.set_text(next_txt, i18n.t("btn_return_hq"))
			gui.set_enabled(next_btn, true)
			gui.set_enabled(next_txt, true)
			gui.set_position(next_btn, vmath.vector3(480, 95, 0))

			gui.set_enabled(revive_btn, false)
			gui.set_enabled(revive_txt, false)

			gui.set_text(rematch_txt, is_ru and "ПОВТОРИТЬ 🔄" or "RETRY 🔄")
			gui.set_enabled(rematch_btn, true)
			gui.set_enabled(rematch_txt, true)
		else
			if winner == constants.TEAM_BLUE then
				gui.set_text(next_txt, i18n.t("btn_next_level"))
				gui.set_enabled(next_btn, true)
				gui.set_enabled(next_txt, true)
				gui.set_position(next_btn, vmath.vector3(480, 95, 0))

				gui.set_enabled(revive_btn, false)
				gui.set_enabled(revive_txt, false)
				gui.set_enabled(rematch_btn, false)
				gui.set_enabled(rematch_txt, false)
			elseif winner == constants.TEAM_RED then
				gui.set_enabled(next_btn, false)
				gui.set_enabled(next_txt, false)

				gui.set_text(revive_txt, i18n.t("btn_revive"))
				gui.set_enabled(revive_btn, true)
				gui.set_enabled(revive_txt, true)
				gui.set_position(revive_btn, vmath.vector3(480, 95, 0))

				gui.set_text(rematch_txt, i18n.t("btn_rematch"))
				gui.set_enabled(rematch_btn, true)
				gui.set_enabled(rematch_txt, true)
			else
				gui.set_enabled(next_btn, false)
				gui.set_enabled(next_txt, false)
				gui.set_enabled(revive_btn, false)
				gui.set_enabled(revive_txt, false)

				gui.set_text(rematch_txt, i18n.t("btn_play_again"))
				gui.set_enabled(rematch_btn, true)
				gui.set_enabled(rematch_txt, true)
			end
		end

		gui.set_enabled(shop_btn, true)
		gui.set_enabled(shop_txt, true)
		gui.set_enabled(menu_btn, true)
		gui.set_enabled(menu_txt, true)
	end
end
