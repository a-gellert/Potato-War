-- gui/game_over/game_over.gui_script
-- Military Debriefing & Combat Results Controller for Potato War
-- Widgets live in gui/game_over/go_*.lua.

local constants = require("lua_modules.constants")
local game_state = require("lua_modules.game_state")
local ui_manager = require("lua_modules.ui_manager")
local i18n = require("lua_modules.i18n")
local strategic_campaign = require("lua_modules.strategic_campaign")
local go_seamless = require("gui.game_over.go_seamless")
local go_frontline = require("gui.game_over.go_frontline")
local go_report = require("gui.game_over.go_report")
local go_actions = require("gui.game_over.go_actions")

local function show_debrief(self, message)
	local winner = message.winner
	local outcome = message.campaign_outcome or strategic_campaign.last_battle_outcome
	local is_campaign = (game_state.mode == constants.MODE_CAMPAIGN) or (outcome ~= nil)

	go_seamless.hide()
	gui.set_text(gui.get_node("header_badge"), i18n.t("debrief_title"))

	go_frontline.layout(is_campaign, outcome)
	go_report.play_sounds(winner, outcome)
	go_report.set_title(winner, is_campaign, outcome)
	go_report.set_stats(is_campaign, outcome)
	go_report.set_rewards(message, winner, outcome)
	go_report.set_hat_progress()
	go_actions.show(message, winner, is_campaign)
end

function init(self)
	msg.post(".", "acquire_input_focus")
	gui.set_render_order(10)
	self.ui = ui_manager.create(self)

	go_actions.register(self)

	-- Hidden by default
	pcall(go_seamless.hide)
	msg.post(".", "disable")
end

function on_input(self, action_id, action)
	if self.seamless_active then
		return true
	end
	return self.ui:on_input(action_id, action)
end

function update(self, dt)
	self.ui:update(dt)
end

function on_message(self, message_id, message, sender)
	if message_id == hash("show_result") then
		msg.post(".", "enable")
		if message.seamless then
			go_seamless.show(self, message, message.winner)
		else
			show_debrief(self, message)
		end
	end
end
