-- gui/main_menu/main_menu.gui_script
-- Main menu controller: home screen, quick-battle lobby, hat shop.
-- Widgets live in gui/main_menu/menu_*.lua.

local ui_manager = require("lua_modules.ui_manager")
local menu_home = require("gui.main_menu.menu_home")
local menu_lobby = require("gui.main_menu.menu_lobby")

function init(self)
	msg.post(".", "acquire_input_focus")
	gui.set_render_order(5)
	self.ui = ui_manager.create(self)
	self.overlay_mode = "skins"

	menu_lobby.init_state(self)
	menu_home.layout()
	menu_home.register(self)
	menu_home.hide_overlays()
	menu_home.update_localized(self)
end

function on_input(self, action_id, action)
	return self.ui:on_input(action_id, action)
end

function update(self, dt)
	self.ui:update(dt)
end

function on_message(self, message_id, message, sender)
	if message_id == hash("show") then
		msg.post(".", "enable")
		menu_home.hide_overlays()
		menu_home.set_background_enabled(true)
		menu_home.update_localized(self)
	elseif message_id == hash("hide") then
		msg.post(".", "disable")
	end
end
