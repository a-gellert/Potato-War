-- gui/hud/hud.gui_script
-- Battle HUD: turn timer circle, wind, weapon bar & inventory, touch controls, tutorial hints, popups.
-- Widgets live in gui/hud/hud_*.lua.

local constants = require("lua_modules.constants")
local weapons = require("lua_modules.weapons")
local game_state = require("lua_modules.game_state")
local ui_manager = require("lua_modules.ui_manager")
local i18n = require("lua_modules.i18n")
local hud_timer = require("gui.hud.hud_timer")
local hud_weapons = require("gui.hud.hud_weapons")
local hud_indicators = require("gui.hud.hud_indicators")
local hud_tutorial = require("gui.hud.hud_tutorial")
local hud_popups = require("gui.hud.hud_popups")

local ACTIVE_BTN_COLOR = vmath.vector4(0.78, 0.58, 0.22, 1.0) -- Warm tactical brass on hold
local NORMAL_BTN_COLOR = vmath.vector4(0.20, 0.23, 0.26, 1.0) -- Graphite steel plate

local function hide_aim()
	msg.post("/aim_guide#aim_guide", "hide_aim")
end

local function update_localization(self)
	pcall(function()
		gui.set_text(gui.get_node("txt_left"), i18n.t("touch_left"))
		gui.set_text(gui.get_node("txt_jump"), i18n.t("touch_jump"))
		gui.set_text(gui.get_node("txt_right"), i18n.t("touch_right"))
		gui.set_text(gui.get_node("txt_pause"), i18n.t("btn_pause"))
		gui.set_text(gui.get_node("txt_inventory"), i18n.t("btn_inventory"))
		gui.set_text(gui.get_node("inventory_title"), i18n.t("inventory_title"))
		gui.set_text(gui.get_node("inventory_sub"), i18n.t("inventory_sub"))
	end)
end

local function detect_touch_screen()
	local sname = sys.get_sys_info().system_name
	local is_touch = (sname == "Android" or sname == "iPhone OS")
	if html5 then
		pcall(function()
			is_touch = html5.run("('ontouchstart' in window || navigator.maxTouchPoints > 0) ? '1' : '0'") == "1"
		end)
	end
	return is_touch
end

-- Hold button that walks/jumps the potato via main.script while pressed
local function register_move_button(self, node_id, dir, other_key, other_dir)
	return self.ui:hold_button(node_id, {
		slop = 14,
		on_press = function()
			pcall(gui.set_color, gui.get_node(node_id), ACTIVE_BTN_COLOR)
			hide_aim()
			msg.post("/main#main", "player_move_state", { dir = dir })
		end,
		on_hold = function(dt)
			msg.post("/main#main", "player_move", { dir = dir, dt = dt })
		end,
		on_release = function()
			pcall(gui.set_color, gui.get_node(node_id), NORMAL_BTN_COLOR)
			local other = self[other_key]
			local fallback_dir = (other and other.is_held) and other_dir or 0
			msg.post("/main#main", "player_move_state", { dir = fallback_dir })
		end,
	})
end

local function register_buttons(self)
	-- Weapon quick slots (instant press on touch)
	for i = 1, hud_weapons.SLOT_COUNT do
		local slot_idx = i
		self.ui:button("btn_wpn_" .. i, function()
			hide_aim()
			game_state.select_slot(slot_idx)
		end, { instant = true, slop = 10 })
	end

	-- Continuous movement & jump for touch controls
	self.left_hb = register_move_button(self, "btn_left", -1, "right_hb", 1)
	self.right_hb = register_move_button(self, "btn_right", 1, "left_hb", -1)
	self.jump_hb = self.ui:hold_button("btn_jump", {
		slop = 14,
		on_press = function()
			pcall(gui.set_color, gui.get_node("btn_jump"), ACTIVE_BTN_COLOR)
			hide_aim()
			msg.post("/main#main", "player_jump")
		end,
		on_release = function()
			pcall(gui.set_color, gui.get_node("btn_jump"), NORMAL_BTN_COLOR)
		end,
	})

	self.ui:button("btn_pause", function()
		hide_aim()
		msg.post("/main#main", "show_menu")
	end, { slop = 12 })

	-- Inventory button, close button and 12 inventory slots
	self.ui:button("btn_inventory", function()
		if game_state.mode ~= constants.MODE_CAMPAIGN then
			hide_aim()
			hud_weapons.toggle_inventory(self)
		end
	end, { slop = 12 })

	self.ui:button("btn_inv_close", function()
		hide_aim()
		hud_weapons.toggle_inventory(self, false)
	end, { slop = 12 })

	for i = 1, hud_weapons.INVENTORY_COUNT do
		local w = weapons.LIST[i]
		if w then
			self.ui:button("inv_slot_" .. i, function()
				hide_aim()
				hud_weapons.select_inventory_weapon(self, w.id)
			end, { slop = 10 })
		end
	end
end

function init(self)
	msg.post(".", "acquire_input_focus")
	gui.set_render_order(2)
	self.ui = ui_manager.create(self)
	self.last_weapon = nil
	self.badge_timer = 0
	self.is_inventory_open = false
	self.is_touch_screen = detect_touch_screen()

	hud_timer.init(self)
	hud_tutorial.init(self)
	pcall(function()
		gui.set_enabled(gui.get_node("inventory_overlay"), false)
	end)
	register_buttons(self)
	update_localization(self)

	-- Ammo changes come from other scripts (firing, crates) where gui.* is unavailable:
	-- only mark the bar dirty and redraw it from this script's update
	game_state.on_ammo_changed = function()
		self.ammo_dirty = true
	end
	hud_weapons.update_selection(self, game_state.selected_weapon_id)
end

function on_input(self, action_id, action)
	if action_id == hash("touch_multi") then
		self.is_touch_screen = true
	end
	-- Key Q / inventory hotkey
	if action_id == hash("inventory") and action.pressed then
		if game_state.mode ~= constants.MODE_CAMPAIGN then
			hud_weapons.toggle_inventory(self)
		end
		return true
	end

	if self.ui:on_input(action_id, action) then
		hide_aim()
		return true
	end

	-- Block background aiming while the inventory is open
	if self.is_inventory_open then
		return true
	end

	-- Swallow touches that start on the HUD control panels so they don't aim
	if action_id == hash("touch") then
		if action.pressed then
			self.panel_touch_captured = false
			local ok_pick, hit_panel = pcall(function()
				local tc = gui.get_node("touch_controls")
				local wp = gui.get_node("weapon_panel")
				return (gui.is_enabled(tc) and gui.pick_node(tc, action.x, action.y))
					or (gui.is_enabled(wp) and gui.pick_node(wp, action.x, action.y))
			end)
			if ok_pick and hit_panel then
				self.panel_touch_captured = true
				hide_aim()
				return true
			end
		elseif action.released then
			if self.panel_touch_captured then
				self.panel_touch_captured = false
				return true
			end
		elseif self.panel_touch_captured then
			return true
		end
	end

	return false
end

function update(self, dt)
	self.ui:update(dt)

	if self.ammo_dirty then
		self.ammo_dirty = false
		hud_weapons.update_selection(self, game_state.selected_weapon_id)
		if self.is_inventory_open then
			hud_weapons.update_inventory(self)
		end
	end

	if game_state.state == constants.STATE_MENU or game_state.state == constants.STATE_GAME_OVER then
		return
	end

	pcall(function()
		gui.set_text(gui.get_node("txt_pause"), i18n.t("btn_pause"))
	end)
	hud_timer.update(self)
	hud_indicators.update_wind(self)
	hud_indicators.update_badges(self, dt)
	hud_tutorial.update(self, dt)
	hud_weapons.update_panels(self)
end

function on_message(self, message_id, message, sender)
	if message_id == hash("match_started") then
		hud_tutorial.reset(self)
		hud_timer.reset(self)
		update_localization(self)
		hud_indicators.update_wind(self)
		hud_weapons.toggle_inventory(self, false)
		hud_weapons.update_inventory(self)
	elseif message_id == hash("toggle_inventory") then
		hud_weapons.toggle_inventory(self)
	elseif message_id == hash("hide_tutorial") or message_id == hash("tutorial_shot_fired") then
		hud_tutorial.on_hide(self)
	elseif message_id == hash("tutorial_tap_hint") then
		hud_tutorial.on_tap_hint(self)
	elseif message_id == hash("show_damage") then
		pcall(hud_popups.show_damage, message)
	elseif message_id == hash("show_achievement_toast") then
		pcall(hud_popups.show_toast, message)
	end
end
