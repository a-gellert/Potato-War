-- gui/hud/hud.gui_script
-- Controls HUD turn banner, 15-second countdown timer, start-of-level card drafting, weapon icons (1-8), and animated tutorial hint

local constants = require("lua_modules.constants")
local weapons = require("lua_modules.weapons")
local game_state = require("lua_modules.game_state")
local ui_manager = require("lua_modules.ui_manager")
local player_profile = require("lua_modules.player_profile")
local i18n = require("lua_modules.i18n")
local camera_controller = require("lua_modules.camera_controller")

local WEAPON_BUTTON_IDS = {
	"btn_wpn_1", "btn_wpn_2", "btn_wpn_3", "btn_wpn_4", "btn_wpn_5"
}

local function update_weapon_selection(self, selected_weapon_id)
	local sel_color = vmath.vector4(0.95, 0.77, 0.06, 1.0) -- Gold
	local def_color = vmath.vector4(0.20, 0.26, 0.34, 1.0) -- Normal available
	local lock_color = vmath.vector4(0.10, 0.12, 0.15, 0.40) -- Empty / locked

	for i = 1, 5 do
		pcall(function()
			local btn_node = gui.get_node(WEAPON_BUTTON_IDS[i])
			local ammo_node = gui.get_node("ammo_wpn_" .. i)
			local icon_node = gui.get_node("icon_wpn_" .. i)
			local num_node = gui.get_node("num_wpn_" .. i)

			local w = game_state.get_slot_weapon(i)

			if w then
				local ammo = game_state.get_ammo(w.id)
				local is_unlocked = game_state.is_weapon_unlocked(w.id)
				local icon_name = w.icon or w.projectile_sprite or "circle"
				gui.play_flipbook(icon_node, hash(icon_name))

				if w.id == "grenade" then
					gui.set_text(ammo_node, "INF")
					gui.set_color(ammo_node, vmath.vector4(0.95, 0.77, 0.06, 1.0))
				else
					gui.set_text(ammo_node, (ammo > 0) and ("x" .. ammo) or "0")
					gui.set_color(ammo_node, (ammo > 0) and vmath.vector4(1, 1, 1, 1) or vmath.vector4(0.5, 0.5, 0.5, 0.5))
				end

				if is_unlocked then
					gui.set_color(btn_node, w.id == selected_weapon_id and sel_color or def_color)
					gui.set_color(icon_node, vmath.vector4(1, 1, 1, 1))
				else
					gui.set_color(btn_node, lock_color)
					gui.set_color(icon_node, vmath.vector4(0.4, 0.4, 0.4, 0.35))
				end
			else
				-- Empty slot in loadout
				gui.set_color(btn_node, lock_color)
				gui.set_color(icon_node, vmath.vector4(0, 0, 0, 0))
				gui.set_text(ammo_node, "")
			end
		end)
	end
end

local function update_hud_localization(self)
	pcall(function()
		gui.set_text(gui.get_node("txt_left"), i18n.t("touch_left"))
		gui.set_text(gui.get_node("txt_jump"), i18n.t("touch_jump"))
		gui.set_text(gui.get_node("txt_right"), i18n.t("touch_right"))
		gui.set_text(gui.get_node("txt_pause"), i18n.t("btn_pause"))
		gui.set_text(gui.get_node("txt_inventory"), i18n.t("btn_inventory"))
		gui.set_text(gui.get_node("inventory_title"), i18n.t("inventory_title"))
		gui.set_text(gui.get_node("inventory_sub"), i18n.t("inventory_sub"))
	end)
end

local function update_inventory_ui(self)
	local sel_color = vmath.vector4(0.95, 0.77, 0.06, 1.0) -- Gold border / active
	local def_color = vmath.vector4(0.18, 0.23, 0.30, 0.95) -- Available
	local dimmed_bg = vmath.vector4(0.06, 0.08, 0.10, 0.40) -- Darkened cell when ammo = 0
	local dimmed_icon = vmath.vector4(0.20, 0.20, 0.20, 0.25)
	local dimmed_txt = vmath.vector4(0.35, 0.35, 0.35, 0.40)

	pcall(function()
		gui.set_text(gui.get_node("inventory_title"), i18n.t("inventory_title"))
		gui.set_text(gui.get_node("inventory_sub"), i18n.t("inventory_sub"))
		gui.set_text(gui.get_node("txt_inventory"), i18n.t("btn_inventory"))
	end)

	for i = 1, 12 do
		local ok, err = pcall(function()
			local w = weapons.LIST[i]
			if not w then return end

			local slot_node = gui.get_node("inv_slot_" .. i)
			local icon_node = gui.get_node("inv_icon_" .. i)
			local name_node = gui.get_node("inv_name_" .. i)
			local count_node = gui.get_node("inv_ammo_" .. i)

			local icon_name = w.icon or w.projectile_sprite or "circle"
			gui.play_flipbook(icon_node, hash(icon_name))

			local name_txt = (i18n.t("weapon_" .. w.id) ~= "weapon_" .. w.id) and i18n.t("weapon_" .. w.id) or (w.name or w.id)
			gui.set_text(name_node, name_txt)

			local ammo = game_state.get_ammo(w.id)
			local is_selected = (game_state.selected_weapon_id == w.id)

			if w.id == "grenade" then
				gui.set_text(count_node, "INF")
				gui.set_color(count_node, vmath.vector4(0.95, 0.77, 0.06, 1.0))
				gui.set_color(slot_node, is_selected and sel_color or def_color)
				gui.set_color(icon_node, vmath.vector4(1, 1, 1, 1))
				gui.set_color(name_node, vmath.vector4(1, 1, 1, 1))
			else
				if ammo > 0 then
					gui.set_text(count_node, "x" .. ammo)
					gui.set_color(count_node, vmath.vector4(1, 1, 1, 1))
					gui.set_color(slot_node, is_selected and sel_color or def_color)
					gui.set_color(icon_node, vmath.vector4(1, 1, 1, 1))
					gui.set_color(name_node, vmath.vector4(1, 1, 1, 1))
				else
					-- 0 ammo: Darken the cell, icon, and labels
					gui.set_text(count_node, "0")
					gui.set_color(count_node, dimmed_txt)
					gui.set_color(slot_node, dimmed_bg)
					gui.set_color(icon_node, dimmed_icon)
					gui.set_color(name_node, dimmed_txt)
				end
			end
		end)
		if not ok then
			constants.log(">>> ERROR IN update_inventory_ui slot " .. i .. ":", err)
		end
	end
end

local function toggle_inventory(self, force_state)
	if game_state.mode == constants.MODE_CAMPAIGN and force_state ~= false then
		self.is_inventory_open = false
		pcall(function()
			gui.set_enabled(gui.get_node("inventory_overlay"), false)
		end)
		return
	end
	if force_state ~= nil then
		self.is_inventory_open = force_state
	else
		self.is_inventory_open = not self.is_inventory_open
	end
	pcall(function()
		gui.set_enabled(gui.get_node("inventory_overlay"), self.is_inventory_open)
	end)
	if self.is_inventory_open then
		update_inventory_ui(self)
	end
end

local function select_inventory_weapon(self, weapon_id)
	local ammo = game_state.get_ammo(weapon_id)
	if weapon_id ~= "grenade" and ammo <= 0 then
		return -- Cannot select empty dimmed weapon!
	end
	game_state.select_weapon(weapon_id)
	update_weapon_selection(self, weapon_id)
	update_inventory_ui(self)
	toggle_inventory(self, false)
end

local function apply_card_ui(card_idx, card)
	pcall(function()
		local pfx = "card_" .. card_idx
		local bg_node = gui.get_node(pfx .. "_bg")
		local title_node = gui.get_node(pfx .. "_title")
		local desc_node = gui.get_node(pfx .. "_desc")
		local badge_bg = gui.get_node(pfx .. "_badge_bg")
		local badge_txt = gui.get_node(pfx .. "_badge_txt")
		local btn_txt = gui.get_node("txt_card_" .. card_idx)

		local title = card.title or (i18n.current_lang == "ru" and "КАРТА" or "CARD")
		local badge = card.badge or (i18n.current_lang == "ru" and "Оружие" or "Weapon")
		local btn_lbl = card.btn_label or (i18n.current_lang == "ru" and "ВЫБРАТЬ" or "SELECT")

		gui.set_text(title_node, title)
		gui.set_text(desc_node, card.desc or "")
		gui.set_text(badge_txt, badge)
		gui.set_text(btn_txt, btn_lbl)

		if card.bg_color then
			gui.set_color(bg_node, vmath.vector4(card.bg_color[1], card.bg_color[2], card.bg_color[3], card.bg_color[4] or 1))
		end
		if card.accent_color then
			gui.set_color(badge_bg, vmath.vector4(card.accent_color[1], card.accent_color[2], card.accent_color[3], 1))
		end
	end)
end

local function hide_tutorial_hint(self)
	self.tutorial_hand_done = true
	pcall(function()
		local h_node = gui.get_node("tutorial_hand")
		if h_node then gui.set_enabled(h_node, false) end
		local r_node = gui.get_node("tutorial_ripple")
		if r_node then gui.set_enabled(r_node, false) end
		local hint_node = gui.get_node("tutorial_hint")
		if hint_node then gui.set_enabled(hint_node, false) end
	end)
end

function init(self)
	msg.post(".", "acquire_input_focus")
	gui.set_render_order(2)
	self.ui = ui_manager.create(self)

	self.last_seconds = -1
	self.last_fraction = -1
	self.last_team = nil
	self.last_weapon = nil
	self.last_points = -1
	self.tutorial_hand_done = false
	self.tutorial_hand_timer = 0

	-- Hide tutorial elements initially
	pcall(function()
		gui.set_enabled(gui.get_node("tutorial_hint"), false)
		gui.set_enabled(gui.get_node("tutorial_hand"), false)
		gui.set_enabled(gui.get_node("tutorial_ripple"), false)
	end)

	-- Register weapon buttons dynamically (instant press on touch for 5 slots)
	for i = 1, 5 do
		local slot_idx = i
		self.ui:button(WEAPON_BUTTON_IDS[i], function()
			msg.post("/aim_guide#aim_guide", "hide_aim")
			game_state.select_slot(slot_idx)
		end, { instant = true, slop = 10 })
	end

	-- Register card selection buttons
	self.ui:button("btn_card_1", function()
		pcall(function()
			gui.set_enabled(gui.get_node("cards_overlay"), false)
		end)
		msg.post("/main#main", "select_card", { card_index = 1 })
	end, { slop = 14 })

	self.ui:button("btn_card_2", function()
		pcall(function()
			gui.set_enabled(gui.get_node("cards_overlay"), false)
		end)
		msg.post("/main#main", "select_card", { card_index = 2 })
	end, { slop = 14 })

	-- Register continuous movement & jump hold buttons for touch controls
	local active_btn_color = vmath.vector4(0.18, 0.72, 0.42, 1.0)
	local normal_btn_color = vmath.vector4(0.22, 0.28, 0.35, 1.0)

	self.left_hb = self.ui:hold_button("btn_left", {
		slop = 14,
		on_press = function()
			pcall(gui.set_color, gui.get_node("btn_left"), active_btn_color)
			msg.post("/aim_guide#aim_guide", "hide_aim")
			msg.post("/main#main", "player_move_state", { dir = -1 })
		end,
		on_hold = function(dt)
			msg.post("/main#main", "player_move", { dir = -1, dt = dt })
		end,
		on_release = function()
			pcall(gui.set_color, gui.get_node("btn_left"), normal_btn_color)
			local fallback_dir = (self.right_hb and self.right_hb.is_held) and 1 or 0
			msg.post("/main#main", "player_move_state", { dir = fallback_dir })
		end,
	})

	self.right_hb = self.ui:hold_button("btn_right", {
		slop = 14,
		on_press = function()
			pcall(gui.set_color, gui.get_node("btn_right"), active_btn_color)
			msg.post("/aim_guide#aim_guide", "hide_aim")
			msg.post("/main#main", "player_move_state", { dir = 1 })
		end,
		on_hold = function(dt)
			msg.post("/main#main", "player_move", { dir = 1, dt = dt })
		end,
		on_release = function()
			pcall(gui.set_color, gui.get_node("btn_right"), normal_btn_color)
			local fallback_dir = (self.left_hb and self.left_hb.is_held) and -1 or 0
			msg.post("/main#main", "player_move_state", { dir = fallback_dir })
		end,
	})

	self.jump_hb = self.ui:hold_button("btn_jump", {
		slop = 14,
		on_press = function()
			pcall(gui.set_color, gui.get_node("btn_jump"), active_btn_color)
			msg.post("/aim_guide#aim_guide", "hide_aim")
			msg.post("/main#main", "player_jump")
		end,
		on_release = function()
			pcall(gui.set_color, gui.get_node("btn_jump"), normal_btn_color)
		end,
	})

	self.ui:button("btn_pause", function()
		msg.post("/aim_guide#aim_guide", "hide_aim")
		msg.post("/main#main", "show_menu")
	end, { slop = 12 })

	-- Register Inventory button and close button
	self.is_inventory_open = false
	pcall(function()
		gui.set_enabled(gui.get_node("inventory_overlay"), false)
	end)

	self.ui:button("btn_inventory", function()
		if game_state.mode ~= constants.MODE_CAMPAIGN then
			msg.post("/aim_guide#aim_guide", "hide_aim")
			toggle_inventory(self)
		end
	end, { slop = 12 })

	self.ui:button("btn_inv_close", function()
		msg.post("/aim_guide#aim_guide", "hide_aim")
		toggle_inventory(self, false)
	end, { slop = 12 })

	-- Register 12 inventory slots
	for i = 1, 12 do
		local slot_idx = i
		local w = weapons.LIST[slot_idx]
		if w then
			self.ui:button("inv_slot_" .. slot_idx, function()
				msg.post("/aim_guide#aim_guide", "hide_aim")
				select_inventory_weapon(self, w.id)
			end, { slop = 10 })
		end
	end

	-- Update static labels with localization
	update_hud_localization(self)

	-- Hook ammo changes from game state
	game_state.on_ammo_changed = function()
		update_weapon_selection(self, game_state.selected_weapon_id)
		if self.is_inventory_open then
			update_inventory_ui(self)
		end
	end

	-- Cards overlay disabled by default
	pcall(function()
		gui.set_enabled(gui.get_node("cards_overlay"), false)
	end)

	update_weapon_selection(self, game_state.selected_weapon_id)
end

function on_input(self, action_id, action)
	-- Key Q / inventory hotkey
	if action_id == hash("inventory") and action.pressed then
		if game_state.mode ~= constants.MODE_CAMPAIGN then
			toggle_inventory(self)
		end
		return true
	end

	local handled = self.ui:on_input(action_id, action)
	if handled then
		msg.post("/aim_guide#aim_guide", "hide_aim")
		return true
	end

	-- Block background aiming when inventory or cards overlay is visible or when touching HUD control panels
	if self.is_inventory_open then
		return true
	end

	if action_id == hash("touch") or action_id == hash("touch_multi") then
		local ok_cards, cards_open = pcall(function()
			return gui.is_enabled(gui.get_node("cards_overlay"))
		end)
		if ok_cards and cards_open then
			return true
		end

		if action_id == hash("touch") then
			if action.pressed then
				self.panel_touch_captured = false
				local ok_pick, hit_panel = pcall(function()
					local tc = gui.get_node("touch_controls")
					local wp = gui.get_node("weapon_panel")
					return (gui.is_enabled(tc) and gui.pick_node(tc, action.x, action.y))
						or (gui.is_enabled(wp) and gui.pick_node(wp, action.x, action.y))
				end)
				if ok_pick and hit_panel then
					self.panel_touch_captured = true
					msg.post("/aim_guide#aim_guide", "hide_aim")
					return true
				end
			elseif action.released then
				if self.panel_touch_captured then
					self.panel_touch_captured = false
					return true
				end
			elseif self.panel_touch_captured then
				return true
			end
		end
	end

	return false
end

function update(self, dt)
	self.ui:update(dt)

	if game_state.state ~= constants.STATE_MENU and game_state.state ~= constants.STATE_GAME_OVER then
		pcall(function()
			gui.set_text(gui.get_node("txt_pause"), i18n.t("btn_pause"))
		end)

		-- 1. Update Timer
		local seconds_left = math.max(0, math.ceil(game_state.turn_timer))
		local fraction = math.max(0, math.min(1.0, game_state.turn_timer / constants.TURN_DURATION))

		if seconds_left ~= self.last_seconds or math.abs(fraction - (self.last_fraction or 0)) > 0.01 then
			self.last_seconds = seconds_left
			self.last_fraction = fraction

			pcall(function()
				local t_txt = gui.get_node("timer_text")
				local t_fill = gui.get_node("timer_bar_fill")
				local t_bg = gui.get_node("timer_bg")

				gui.set_text(t_txt, tostring(seconds_left))
				gui.set_scale(t_fill, vmath.vector3(fraction, 1.0, 1.0))

				if seconds_left <= 5 then
					gui.set_color(t_bg, vmath.vector4(0.91, 0.30, 0.24, 1.0))
					gui.set_color(t_fill, vmath.vector4(0.91, 0.30, 0.24, 1.0))
				else
					gui.set_color(t_bg, vmath.vector4(0.95, 0.77, 0.06, 1.0))
					gui.set_color(t_fill, vmath.vector4(0.18, 0.80, 0.44, 1.0))
				end
			end)
		end

		-- 2. Update Turn Banner & check Turn 1 Tutorial Trigger
		if game_state.active_team ~= self.last_team then
			self.last_team = game_state.active_team

			pcall(function()
				local banner = gui.get_node("banner_text")
				local bg = gui.get_node("banner_bg")

				if game_state.active_team == constants.TEAM_BLUE then
					gui.set_text(banner, i18n.t("turn_blue"))
					gui.set_color(bg, vmath.vector4(0.12, 0.30, 0.55, 0.90))
				else
					if game_state.mode == constants.MODE_PVP_BOTS then
						gui.set_text(banner, i18n.t("turn_red_pvp_bot"))
					elseif game_state.mode == constants.MODE_QUICK_PVP then
						gui.set_text(banner, i18n.t("turn_red_pvp"))
					else
						gui.set_text(banner, i18n.t("turn_red_bot"))
					end
					gui.set_color(bg, vmath.vector4(0.65, 0.18, 0.15, 0.90))
					hide_tutorial_hint(self)
				end
			end)
		end

		-- Animated tutorial hand: semi-transparent hand that presses and moves towards enemy over the active potato
		local is_arena_1 = (game_state.mode == constants.MODE_CAMPAIGN and (game_state.campaign_level or 1) == 1) or (game_state.mode ~= constants.MODE_CAMPAIGN)
		local should_show_hand = not self.tutorial_hand_done
			and is_arena_1
			and game_state.state == constants.STATE_TURN_ACTIVE
			and game_state.active_team == constants.TEAM_BLUE
			and not game_state.is_aiming

		if should_show_hand then
			pcall(function()
				local hint_node = gui.get_node("tutorial_hint")
				if hint_node then
					gui.set_enabled(hint_node, true)
					gui.set_text(hint_node, i18n.t("tutorial_hint"))
				end
			end)

			local p = game_state.active_potato
			if p and p.is_alive then
				self.tutorial_hand_timer = (self.tutorial_hand_timer or 0) + dt
				local cycle = self.tutorial_hand_timer % 1.55

				local cx = camera_controller.pos and camera_controller.pos.x or 480
				local cy = camera_controller.pos and camera_controller.pos.y or 270
				local sx = p.pos.x - (cx - 480)
				local sy = p.pos.y - (cy - 270)

				local alpha = 0
				local scale = 0.62
				local x_off = 11
				local y_off = -17
				local ripple_alpha = 0
				local ripple_scale = 0.3

				if cycle < 0.25 then
					-- 1. Fade in & press down on potato
					local t = cycle / 0.25
					alpha = 0.75 * t
					scale = 0.76 - 0.14 * t
					ripple_alpha = 0.55 * (1.0 - t)
					ripple_scale = 0.3 + 0.5 * t
				elseif cycle < 1.00 then
					-- 2. Drag towards enemy (to the right & slightly up)
					local t = (cycle - 0.25) / 0.75
					local eased = (t < 0.5) and (2 * t * t) or (-1 + (4 - 2 * t) * t)
					alpha = 0.75
					scale = 0.62
					x_off = 11 + 75 * eased
					y_off = -17 + 24 * math.sin(eased * math.pi * 0.5)
				elseif cycle < 1.30 then
					-- 3. Release & fade out
					local t = (cycle - 1.00) / 0.30
					alpha = 0.75 * (1.0 - t)
					scale = 0.62 + 0.14 * t
					x_off = 11 + 75
					y_off = -17 + 24
				else
					-- 4. Pause before repeating
					alpha = 0
				end

				pcall(function()
					local h_node = gui.get_node("tutorial_hand")
					local r_node = gui.get_node("tutorial_ripple")

					if alpha > 0.02 then
						gui.set_enabled(h_node, true)
						gui.set_position(h_node, vmath.vector3(sx + x_off, sy + y_off, 0))
						gui.set_scale(h_node, vmath.vector3(scale, scale, 1))
						gui.set_color(h_node, vmath.vector4(1, 1, 1, alpha))
					else
						gui.set_enabled(h_node, false)
					end

					if ripple_alpha > 0.02 then
						gui.set_enabled(r_node, true)
						gui.set_position(r_node, vmath.vector3(sx, sy, 0))
						gui.set_scale(r_node, vmath.vector3(ripple_scale, ripple_scale, 1))
						gui.set_color(r_node, vmath.vector4(1, 1, 1, ripple_alpha))
					else
						gui.set_enabled(r_node, false)
					end
				end)
			else
				pcall(function()
					gui.set_enabled(gui.get_node("tutorial_hand"), false)
					gui.set_enabled(gui.get_node("tutorial_ripple"), false)
				end)
			end
		else
			pcall(function()
				gui.set_enabled(gui.get_node("tutorial_hand"), false)
				gui.set_enabled(gui.get_node("tutorial_ripple"), false)
			end)
		end

		-- 3. Update Weapon Selection & panel visibility
		pcall(function()
			local wp_node = gui.get_node("weapon_panel")
			local tc_node = gui.get_node("touch_controls")
			local inv_btn = gui.get_node("btn_inventory")
			local is_player_turn = not game_state.is_bot_turn() and game_state.state == constants.STATE_TURN_ACTIVE
			local is_pvp = (game_state.mode == constants.MODE_PVP_BOTS or game_state.mode == constants.MODE_QUICK_PVP)

			local is_campaign = (game_state.mode == constants.MODE_CAMPAIGN)
			if is_pvp then
				gui.set_enabled(wp_node, false)
			else
				gui.set_enabled(wp_node, is_player_turn)
			end

			gui.set_enabled(tc_node, is_player_turn)
			gui.set_enabled(inv_btn, (not is_campaign) and is_player_turn)
		end)

		if game_state.selected_weapon_id ~= self.last_weapon then
			self.last_weapon = game_state.selected_weapon_id
			update_weapon_selection(self, game_state.selected_weapon_id)
		end

		-- 4. Update Points & Mode Info
		local pts = player_profile.get_points()
		if pts ~= self.last_points then
			self.last_points = pts
			pcall(function()
				gui.set_text(gui.get_node("points_text"), i18n.t("points_lbl") .. tostring(pts))
			end)
		end

		pcall(function()
			local mode_node = gui.get_node("mode_text")
			if game_state.mode == constants.MODE_CAMPAIGN then
				local p = game_state.active_potato
				local hp_str = p and tostring(p.hp) or "100"
				local arena_prefix = (i18n.current_lang == "ru") and "Арена " or "Arena "
				gui.set_text(mode_node, arena_prefix .. tostring(game_state.campaign_level or 1) .. " (HP:" .. hp_str .. ")")
			elseif game_state.mode == constants.MODE_PVP_BOTS then
				gui.set_text(mode_node, i18n.t("mode_pvp_bots"))
			elseif game_state.mode == constants.MODE_QUICK_BOT then
				gui.set_text(mode_node, i18n.t("mode_bot"))
			elseif game_state.mode == constants.MODE_QUICK_PVP then
				gui.set_text(mode_node, i18n.t("mode_pvp"))
			end
		end)
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("match_started") then
		self.tutorial_hand_done = false
		self.tutorial_hand_timer = 0
		update_hud_localization(self)
		toggle_inventory(self, false)
		update_inventory_ui(self)
	elseif message_id == hash("toggle_inventory") then
		toggle_inventory(self)
	elseif message_id == hash("show_cards") then
		self.tutorial_hand_done = false
		self.tutorial_hand_timer = 0
		pcall(function()
			local overlay = gui.get_node("cards_overlay")
			local title_node = gui.get_node("cards_title")
			local sub_node = gui.get_node("cards_subtitle")

			gui.set_text(title_node, i18n.t("cards_start_title"))
			gui.set_text(sub_node, i18n.t("cards_start_subtitle"))
			gui.set_enabled(overlay, true)

			if message.card1 then
				apply_card_ui(1, message.card1)
			end
			if message.card2 then
				apply_card_ui(2, message.card2)
			end
		end)
	elseif message_id == hash("hide_cards") then
		pcall(function()
			gui.set_enabled(gui.get_node("cards_overlay"), false)
		end)
	elseif message_id == hash("hide_tutorial") or message_id == hash("tutorial_shot_fired") then
		hide_tutorial_hint(self)
	elseif message_id == hash("show_damage") then
		pcall(function()
			local sx, sy = camera_controller.world_to_screen(message.x or 480, message.y or 270)
			local x = sx
			local y = sy + 18
			local amt = message.amount or 0
			local is_heal = (message.is_heal == true)
			local is_crit = (not is_heal) and (amt >= 45)

			local prefix = is_heal and "+" or "-"
			local txt_node = gui.new_text_node(vmath.vector3(x, y, 0), prefix .. tostring(amt))
			gui.set_font(txt_node, "system_font")
			local scale = is_heal and 0.80 or (is_crit and 0.85 or 0.65)
			gui.set_scale(txt_node, vmath.vector3(scale, scale, 1.0))
			if is_heal then
				gui.set_color(txt_node, vmath.vector4(0.18, 0.95, 0.35, 1.0)) -- Vibrant emerald green
			elseif is_crit then
				gui.set_color(txt_node, vmath.vector4(1.0, 0.22, 0.15, 1.0)) -- Crit red
			else
				gui.set_color(txt_node, vmath.vector4(1.0, 0.85, 0.2, 1.0)) -- Gold/yellow
			end

			-- Floating upward & fading
			gui.animate(txt_node, "position.y", y + 42, gui.EASING_OUTQUAD, 0.75)
			gui.animate(txt_node, "color.w", 0.0, gui.EASING_INQUAD, 0.75, 0.15, function()
				pcall(gui.delete_node, txt_node)
			end)
		end)
	elseif message_id == hash("show_achievement_toast") then
		pcall(function()
			local panel = gui.get_node("toast_panel")
			local txt = gui.get_node("toast_text")
			local pts = message.points or 0
			local pts_str = ""
			if pts > 0 then
				pts_str = (i18n.current_lang == "ru") and (" +" .. tostring(pts) .. " очков!") or (" +" .. tostring(pts) .. " pts!")
			end
			local icon = message.icon or "🏆"
			local title = message.title or ""
			gui.set_text(txt, icon .. " " .. title .. pts_str)
			gui.set_enabled(panel, true)

			gui.cancel_animation(panel, gui.PROP_POSITION)
			gui.cancel_animation(panel, gui.PROP_SCALE)
			gui.set_position(panel, vmath.vector3(480, 520, 0))
			gui.set_scale(panel, vmath.vector3(0.85, 0.85, 1.0))

			gui.animate(panel, gui.PROP_POSITION, vmath.vector3(480, 460, 0), gui.EASING_OUTBACK, 0.35)
			gui.animate(panel, gui.PROP_SCALE, vmath.vector3(1.0, 1.0, 1.0), gui.EASING_OUTBACK, 0.35, 0, function()
				gui.animate(panel, gui.PROP_POSITION, vmath.vector3(480, 530, 0), gui.EASING_INQUAD, 0.35, 1.8, function()
					gui.set_enabled(panel, false)
				end)
			end)
		end)
	end
end
